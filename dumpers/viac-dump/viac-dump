#!/bin/bash
# Host-side wrapper around `docker run` for the viac-dump
# container. Mounts ~/.secrets/ (RW; cookie-jar state file lands
# here) and the bronze directory (RW), and forwards all arguments
# to the container's entrypoint.

set -euo pipefail

IMAGE="${VIAC_IMAGE:-viac-dump:latest}"
CONTAINER_NAME="${VIAC_CONTAINER:-viac-dump}"

HERE="$(cd "$(dirname "$0")" && pwd)"

# Mount points on the host. Override via env if your layout differs.
HOST_SECRETS="${VIAC_SECRETS_DIR:-$HOME/.secrets}"
HOST_DATA="${VIAC_DATA_DIR:-$HOME/wealthdb/viac}"

usage() {
    cat <<EOF
viac-dump — host wrapper

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Mint or refresh the session cookie jar +
                      CSRF metadata. Use --check for a cheap
                      liveness probe (no MFA push).
  download [args...]  Bronze dump. Use --dry-run to walk JSON
                      endpoints without fetching PDFs;
                      --with-transaction-documents to also pull
                      the per-event TRANSACTION PDFs (adds ~950
                      docs to the run).
  load [args...]      Parse bronze into the silver SQLite DB.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
  $HOST_SECRETS  ->  /secrets   (viac.env + viac-state.json)
  $HOST_DATA     ->  /data      (bronze artefacts + silver DB)

Override mounts via env:
  VIAC_SECRETS_DIR=/path/to/secrets
  VIAC_DATA_DIR=/path/to/data

Credentials:
  VIAC_LOGIN (E.164 mobile number, e.g. +CC<digits>) and
  VIAC_PASSWORD are read from /secrets/viac.env automatically
  (= \$HOME/.secrets/viac.env on the host). Use SINGLE quotes
  around values containing \$, \!, backtick.

Container concurrency:
  Only one viac-dump container runs at a time (fixed name
  '$CONTAINER_NAME'). The wrapper refuses to clobber a
  RUNNING container — set VIAC_FORCE_REPLACE=1 to override.
EOF
}

# ./viac-dump build [extra docker build flags]
if [[ "${1:-}" == "build" ]]; then
    shift
    exec docker build -t "$IMAGE" "$@" "$HERE"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    usage
    exit 0
fi

# Ensure mount points exist on the host before we mount them.
# Docker would silently create them as root-owned otherwise.
mkdir -p "$HOST_DATA"
if [[ ! -d "$HOST_SECRETS" ]]; then
    echo "viac-dump: secrets dir does not exist: $HOST_SECRETS" >&2
    echo "Create it with: mkdir -p $HOST_SECRETS && chmod 700 $HOST_SECRETS" >&2
    exit 1
fi

# Allocate a TTY only when stdin AND stdout are TTYs. Safe to
# pipe (e.g. for log capture) while still giving interactive
# prompts when run from a terminal.
TTY_ARGS=()
if [[ -t 0 && -t 1 ]]; then
    TTY_ARGS=(-it)
fi

# Safety guard: refuse to clobber a RUNNING container. Two
# concurrent viac-dump invocations would race on
# /secrets/viac-state.json (login writes, download reads).
if docker ps --filter "name=^${CONTAINER_NAME}$" --filter "status=running" -q | grep -q .; then
    if [[ "${VIAC_FORCE_REPLACE:-0}" != "1" ]]; then
        echo "viac-dump: a container named '$CONTAINER_NAME' is already running." >&2
        echo "  Refusing to evict — that could clobber a state-file write in progress." >&2
        echo "  Options:" >&2
        echo "    * Use a different name:    VIAC_CONTAINER=otherthing $0 $*" >&2
        echo "    * Enter the existing one:  docker exec -it $CONTAINER_NAME sh" >&2
        echo "    * Force replace:           VIAC_FORCE_REPLACE=1 $0 $*" >&2
        exit 2
    fi
    echo "viac-dump: VIAC_FORCE_REPLACE=1 — evicting live container" >&2
fi

# Evict any prior (stopped) container with this name — no-op
# when the name isn't in use. Past this point we've already
# refused to clobber a RUNNING container; only stopped state
# is affected.
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --name "$CONTAINER_NAME" \
    ${TTY_ARGS[@]+"${TTY_ARGS[@]}"} \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e VIAC_LOGIN \
    -e VIAC_PASSWORD \
    -v "$HOST_SECRETS:/secrets" \
    -v "$HOST_DATA:/data" \
    -v "$HERE:/app" \
    "$IMAGE" "$@"
