#!/bin/bash
# Host-side wrapper around `docker run` for the fidelity-web-dump
# container. Mounts ~/.secrets/ (RW; the container needs to write
# the state file there during login) and the bronze directory (RW),
# and forwards all arguments to the container's entrypoint.

set -euo pipefail

IMAGE="${FIDELITY_WEB_IMAGE:-fidelity-web-dump:latest}"

# Fixed container name. Image-hash drift (e.g. after a rebuild)
# would otherwise hide running containers from
# `docker ps --filter ancestor=fidelity-web-dump:latest`; with a
# fixed name, `docker rm -f fidelity-web-dump` is a reliable
# kill-switch regardless of which image revision a container was
# started against. Single-name across subcommands means we
# implicitly enforce "only one fidelity-web-dump container at a
# time" — which matches the per-profile single-writer model the
# session state needs anyway. See the safety-guard block below for
# the lesson that motivated this — schwab-web-dump's wrapper
# without it would silently evict a live VNC-login session.
CONTAINER_NAME="${FIDELITY_WEB_CONTAINER:-fidelity-web-dump}"

HERE="$(cd "$(dirname "$0")" && pwd)"

# Mount points on the host. Override via env if your layout differs.
HOST_SECRETS="${FIDELITY_WEB_SECRETS_DIR:-$HOME/.secrets}"
HOST_DATA="${FIDELITY_WEB_DATA_DIR:-$HOME/wealthdb/fidelity-web}"
# A separate writable dir for opt-in debug artefacts (screenshots,
# Playwright trace bundles, ad-hoc HTML drops). Kept OUT of HOST_DATA
# so the bronze + silver tree stays clean — only `--screenshot-dir
# /debug/...`, `--trace /debug/...`, etc. should write here.
HOST_DEBUG="${FIDELITY_WEB_DEBUG_DIR:-$HOME/.cache/fidelity-web-debug}"

usage() {
    cat <<EOF
fidelity-web-dump — host wrapper

Subcommands:
  build                 Build the Docker image (\`docker build\`).
  login [args...]       Mint or refresh the session state file.
                        Prompts on stdin for the Fidelity 2FA code
                        (Duo / Authenticator / Symantec VIP). Stdin
                        must be a TTY.
  download [args...]    Export bronze artefacts (positions,
                        transactions, statements) from fidelity.com.
  load [args...]        Parse bronze into the silver SQLite DB.
  vnc-login [args...]   Fallback to a VNC-driven login when the
                        CLI-MFA selectors drift or a non-code
                        challenge is required. Starts x11vnc on
                        127.0.0.1:5900; tunnel + connect from your
                        local VNC client.
  sh|bash               Open an interactive shell in the container.
  help                  Show this message.

Mounted into the container:
  $HOST_SECRETS  ->  /secrets   (state file lives here)
  $HOST_DATA     ->  /data      (bronze artefacts + silver DB)
  $HOST_DEBUG    ->  /debug     (opt-in screenshots / traces)

Override mounts via env:
  FIDELITY_WEB_SECRETS_DIR=/path/to/secrets
  FIDELITY_WEB_DATA_DIR=/path/to/data
  FIDELITY_WEB_DEBUG_DIR=/path/to/debug

Credentials:
  The username is read from \$FIDELITY_USERNAME inside the container;
  the password from \$FIDELITY_PASSWORD (or prompted interactively
  when not set). The login script sources /secrets/fidelity-web.env
  automatically (= \$HOME/.secrets/fidelity-web.env on the host).

  Use SINGLE QUOTES around values containing \$, \!, backtick, or
  other shell metacharacters. Double quotes would let the host
  shell do \$-expansion when sourcing the file, which silently
  mangles the password before it reaches the container:
    FIDELITY_USERNAME='your-username'
    FIDELITY_PASSWORD='your-password-with-\$pecial-chars'
  chmod 600 the file. Password may also be left out and supplied
  interactively at \`login\` time.
EOF
}

# ./fidelity-web-dump build [extra docker build flags]
if [[ "${1:-}" == "build" ]]; then
    shift
    exec docker build -t "$IMAGE" "$@" "$HERE"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    usage
    exit 0
fi

# ./fidelity-web-dump download [...]  → wrapper-side trigger write.
#
# The login container holds the live Camoufox + polls
# $HOST_DATA/.download-trigger; this command just writes that
# file with the requested config and exits. No docker container
# spawned — both because the trigger is purely a host-side file
# write, and because spawning a container with the fixed
# CONTAINER_NAME would collide with the running login. The login
# container's keep-alive loop picks up the trigger on its next
# 2-second poll and runs the scrape in-place.
if [[ "${1:-}" == "download" ]]; then
    mkdir -p "$HOST_DATA"
    shift
    DEST_PATH="/data"
    MODE="all"
    SINCE=""
    UNTIL=""
    EXCLUDE=""
    DRY_RUN="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dest)              shift; DEST_PATH="$1" ;;
            --mode)              shift; MODE="$1" ;;
            --since)             shift; SINCE="$1" ;;
            --until)             shift; UNTIL="$1" ;;
            --exclude-accounts)  shift; EXCLUDE="$1" ;;
            --dry-run)           DRY_RUN="true" ;;
            --no-dry-run)        DRY_RUN="false" ;;
            -h|--help)
                cat <<EOH
fidelity-web-dump download — trigger a scrape

Writes \$HOST_DATA/.download-trigger with the per-scrape config; the
running login keep-alive loop picks it up on its next ~2s poll and
runs the scrape against its live Camoufox session.

Flags:
  --dest <path>             Bronze tree root inside container (default: /data)
  --mode {all,positions,activity,documents,balances,performance}
                            (default: all)
  --since YYYY-MM-DD        Earliest date for windowed surfaces
  --until YYYY-MM-DD        Latest date (default: today UTC)
  --exclude-accounts <a,b>  Comma-separated account ids to skip
  --dry-run / --no-dry-run                            (default: --no-dry-run)
EOH
                exit 0
                ;;
            *)
                echo "fidelity-web-dump download: unknown flag $1" >&2
                exit 2
                ;;
        esac
        shift
    done
    {
        echo "dest=$DEST_PATH"
        echo "mode=$MODE"
        echo "dry_run=$DRY_RUN"
        [[ -n "$SINCE"   ]] && echo "since=$SINCE"
        [[ -n "$UNTIL"   ]] && echo "until=$UNTIL"
        [[ -n "$EXCLUDE" ]] && echo "exclude_accounts=$EXCLUDE"
    } > "$HOST_DATA/.download-trigger"
    echo "fidelity-web-dump: download triggered ($HOST_DATA/.download-trigger):" >&2
    sed 's/^/  /' "$HOST_DATA/.download-trigger" >&2
    echo "  (the running login container will pick this up on" >&2
    echo "  its next ~2s poll; bronze lands under $HOST_DATA/<UTC-ts>/.)" >&2
    exit 0
fi

# ./fidelity-web-dump load [args...]  → host-side python3 invocation.
#
# The silver loader is pure-stdlib Python (sqlite3 + csv + json
# + hashlib + re); no Camoufox / Playwright / container needed.
# Running it host-side means it can execute in parallel with a
# live `login` keep-alive container without tripping the
# safety guard further down, and it avoids the docker-spin
# overhead for what's just a file walk + SQLite writes.
#
# Defaults match the container layout (silver under <data>/...,
# bronze tree = <data>). Forward all flags through.
if [[ "${1:-}" == "load" ]]; then
    mkdir -p "$HOST_DATA"
    shift
    SILVER_DB="$HOST_DATA/fidelity-web.db"
    BRONZE_DIR="$HOST_DATA"
    PASSTHRU=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --silver-db) shift; SILVER_DB="$1" ;;
            --bronze-dir) shift; BRONZE_DIR="$1" ;;
            -h|--help)
                cat <<EOH
fidelity-web-dump load — parse bronze into silver SQLite

Runs host-side (pure stdlib Python). Default silver DB lives at
\$HOST_DATA/fidelity-web.db; default bronze tree is \$HOST_DATA
itself.

Flags:
  --silver-db <file>    SQLite path (default: \$HOST_DATA/fidelity-web.db)
  --bronze-dir <dir>    Bronze tree root (default: \$HOST_DATA)
  -v, --verbose         DEBUG-level logging
EOH
                exit 0
                ;;
            *) PASSTHRU+=("$1") ;;
        esac
        shift
    done
    exec python3 "$HERE/load.py" \
        --silver-db "$SILVER_DB" \
        --bronze-dir "$BRONZE_DIR" \
        ${PASSTHRU[@]+"${PASSTHRU[@]}"}
fi

# Ensure mount points exist on the host before we mount them. Docker
# will silently create them as root-owned directories if we don't.
mkdir -p "$HOST_DATA"
mkdir -p "$HOST_DEBUG"
if [[ ! -d "$HOST_SECRETS" ]]; then
    echo "fidelity-web-dump: secrets dir does not exist: $HOST_SECRETS" >&2
    echo "Create it with: mkdir -p $HOST_SECRETS && chmod 700 $HOST_SECRETS" >&2
    exit 1
fi

# Allocate a TTY only when stdin AND stdout are TTYs. This makes the
# wrapper safe to pipe (e.g. for log capture) while still giving
# interactive prompts when run from a terminal. The `${arr[@]+...}`
# idiom expands to nothing when the array is empty, which keeps
# bash 3.2 (Apple's /bin/bash) happy under `set -u`.
TTY_ARGS=()
if [[ -t 0 && -t 1 ]]; then
    TTY_ARGS=(-it)
fi

# `vnc-login` needs the VNC port forwarded to the host so the
# user's VNC client can connect. Bind to 127.0.0.1 only — the VNC
# server inside the container has no network-facing auth and we
# don't want it reachable from the LAN.
EXTRA_ARGS=()
if [[ "${1:-}" == "vnc-login" ]]; then
    EXTRA_ARGS+=(-p 127.0.0.1:5900:5900)
fi

# Safety guard: refuse to clobber a live container.
#
# Inherited lesson from schwab-web-dump: running a second wrapper
# invocation while a `login` / `vnc-login` keep-alive session is
# active would otherwise `docker rm -f` the live container and
# kill the Fidelity session — costing a fresh MFA round. Check
# whether a RUNNING container with this name exists; if so, refuse
# and explain the options. Pass FIDELITY_WEB_FORCE_REPLACE=1 to
# override (when the live session is known-stuck).
if docker ps --filter "name=^${CONTAINER_NAME}$" --filter "status=running" -q | grep -q .; then
    if [[ "${FIDELITY_WEB_FORCE_REPLACE:-0}" != "1" ]]; then
        echo "fidelity-web-dump: a container named '$CONTAINER_NAME' is already running." >&2
        echo "  Refusing to evict it — that would kill any live Fidelity session." >&2
        echo "  Options:" >&2
        echo "    * Use a different name:    FIDELITY_WEB_CONTAINER=otherthing $0 $*" >&2
        echo "    * Enter the existing one:  docker exec -it $CONTAINER_NAME sh" >&2
        echo "    * Force replace:           FIDELITY_WEB_FORCE_REPLACE=1 $0 $*" >&2
        exit 2
    fi
    echo "fidelity-web-dump: FIDELITY_WEB_FORCE_REPLACE=1 — evicting live container" >&2
fi

# Evict any prior (stopped) container with this name (best-effort
# — no-op when the name isn't in use). Past this point we've
# already refused to clobber a RUNNING container; this only affects
# exited-but-not-cleaned-up state.
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --name "$CONTAINER_NAME" \
    ${TTY_ARGS[@]+"${TTY_ARGS[@]}"} \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e FIDELITY_USERNAME \
    -e FIDELITY_PASSWORD \
    -v "$HOST_SECRETS:/secrets" \
    -v "$HOST_DATA:/data" \
    -v "$HOST_DEBUG:/debug" \
    -v "$HERE:/app" \
    "$IMAGE" "$@"
