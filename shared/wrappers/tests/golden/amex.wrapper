=== vnc-login
--- calls
docker
  image
  inspect
  --format
  {{.Id}}
  wealthdb/amex:latest
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^amex$
  --filter
  status=running
  -q
docker
  rm
  -f
  amex
docker
  run
  --rm
  --pull=never
  --name
  amex
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  AMEX_USERNAME
  -e
  AMEX_PASSWORD
  -v
  <TMP>/w-amex/home/.secrets:/secrets
  -v
  <TMP>/w-amex/xdgdata/wealthdb/amex:/data
  -v
  <TMP>/w-amex/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-amex/xdgcache/wealthdb/amex:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-amex/xdgcache/wealthdb/debug/amex:/debug
  -v
  <TMP>/w-amex/tree/collectors/amex:/app
  wealthdb/amex:latest
  vnc-login
  [env] AMEX_USERNAME=<unset>
  [env] AMEX_PASSWORD=<unset>
exit: 0
