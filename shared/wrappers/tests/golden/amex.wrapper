--- calls
python3
  -
  <TMP>/w-amex/tree/collectors/amex/Dockerfile
  <TMP>/w-amex/tree/collectors/amex/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/amex:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
