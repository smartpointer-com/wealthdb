=== build
--- calls
python3
  -
  <TMP>/w-viac/tree/collectors/viac/Dockerfile
  <TMP>/w-viac/tree/collectors/viac/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/viac:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
  wealthdb/viac:latest
  <TMP>/w-viac/tree/collectors/viac
exit: 0
