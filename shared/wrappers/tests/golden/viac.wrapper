=== login
--- calls
docker
  ps
  --filter
  name=^viac$
  --filter
  status=running
  -q
docker
  rm
  -f
  viac
docker
  run
  --rm
  --name
  viac
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  VIAC_LOGIN
  -e
  VIAC_PASSWORD
  -v
  <TMP>/w-viac/home/.secrets:/secrets
  -v
  <TMP>/w-viac/xdgdata/wealthdb/viac:/data
  -v
  <TMP>/w-viac/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-viac/tree/collectors/viac:/app
  wealthdb/viac:latest
  login
  [env] VIAC_LOGIN=<unset>
  [env] VIAC_PASSWORD=<unset>
exit: 0
