=== login
--- calls
docker
  ps
  --filter
  name=^cointracking$
  --filter
  status=running
  -q
docker
  rm
  -f
  cointracking
docker
  image
  inspect
  --format
  {{.Id}}
  wealthdb/cointracking:latest
docker
  run
  --rm
  --pull=never
  --name
  cointracking
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  COINTRACKING_USERNAME
  -e
  COINTRACKING_PASSWORD
  -e
  BINANCE_API_KEY
  -e
  COINTRACKING_TIMEZONES
  -v
  <TMP>/w-cointracking/home/.secrets:/secrets
  -v
  <TMP>/w-cointracking/xdgdata/wealthdb/cointracking:/data
  -v
  <TMP>/w-cointracking/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-cointracking/xdgcache/wealthdb/cointracking:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-cointracking/xdgcache/wealthdb/debug/cointracking:/debug
  -v
  <TMP>/w-cointracking/tree/collectors/cointracking:/app
  wealthdb/cointracking:latest
  login
  [env] COINTRACKING_USERNAME=<unset>
  [env] COINTRACKING_PASSWORD=<unset>
  [env] BINANCE_API_KEY=<unset>
  [env] COINTRACKING_TIMEZONES=<unset>
exit: 0
