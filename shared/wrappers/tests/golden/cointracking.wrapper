  <TMP>/w-cointracking/tree/collectors/cointracking/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/cointracking:latest
docker
  build
  --provenance=false
  --build-arg
