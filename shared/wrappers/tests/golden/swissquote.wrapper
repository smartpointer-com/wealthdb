=== login
--- calls
docker
  run
  --rm
  --name
  swissquote
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  SWISSQUOTE_USERNAME
  -e
  SWISSQUOTE_PASSWORD
  -v
  <TMP>/w-swissquote/home/.secrets:/secrets
  -v
  <TMP>/w-swissquote/xdgdata/wealthdb/swissquote:/data
  -v
  <TMP>/w-swissquote/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-swissquote/xdgcache/wealthdb/swissquote:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-swissquote/xdgcache/wealthdb/debug/swissquote:/debug
  -v
  <TMP>/w-swissquote/tree/collectors/swissquote:/app
  wealthdb/swissquote:latest
  login
  [env] SWISSQUOTE_USERNAME=<unset>
  [env] SWISSQUOTE_PASSWORD=<unset>
exit: 0
