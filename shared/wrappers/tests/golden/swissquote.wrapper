=== build
--- calls
python3
  -
  <TMP>/w-swissquote/tree/collectors/swissquote/Dockerfile
  <TMP>/w-swissquote/tree/collectors/swissquote/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/swissquote:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
  wealthdb/swissquote:latest
  <TMP>/w-swissquote/tree/collectors/swissquote
exit: 0
