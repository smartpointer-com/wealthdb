=== explore
--- calls
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^carta$
  --filter
  status=running
  -q
docker
  rm
  -f
  carta
docker
  image
  inspect
  --format
  {{.Id}}
  wealthdb/carta:latest
docker
  run
  --rm
  --pull=never
  --name
  carta
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  CARTA_USERNAME
  -e
  CARTA_EMAIL
  -e
  CARTA_PASSWORD
  -v
  <TMP>/w-carta/home/.secrets:/secrets
  -v
  <TMP>/w-carta/xdgdata/wealthdb/carta:/data
  -v
  <TMP>/w-carta/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-carta/xdgcache/wealthdb/carta:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-carta/xdgcache/wealthdb/debug/carta:/debug
  -v
  <TMP>/w-carta/tree/collectors/carta:/app
  wealthdb/carta:latest
  explore
  [env] CARTA_USERNAME=<unset>
  [env] CARTA_EMAIL=<unset>
  [env] CARTA_PASSWORD=<unset>
exit: 0
