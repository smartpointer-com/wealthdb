=== login
--- calls
docker
  ps
  --filter
  name=^relevate$
  --filter
  status=running
  -q
docker
  rm
  -f
  relevate
docker
  image
  inspect
  --format
  {{.Id}}
  wealthdb/relevate:latest
docker
  run
  --rm
  --pull=never
  --name
  relevate
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  RELEVATE_LOGIN
  -e
  RELEVATE_PASSWORD
  -v
  <TMP>/w-relevate/home/.secrets:/secrets
  -v
  <TMP>/w-relevate/xdgdata/wealthdb/relevate:/data
  -v
  <TMP>/w-relevate/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-relevate/xdgcache/wealthdb/relevate:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-relevate/xdgcache/wealthdb/debug/relevate:/debug
  -v
  <TMP>/w-relevate/tree/collectors/relevate:/app
  wealthdb/relevate:latest
  login
  [env] RELEVATE_LOGIN=invented-RELEVATE_LOGIN
  [env] RELEVATE_PASSWORD=invented-RELEVATE_PASSWORD
exit: 0
