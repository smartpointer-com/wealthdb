=== vnc-login
--- calls
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^schwab-web$
  --filter
  status=running
  -q
docker
  rm
  -f
  schwab-web
docker
  run
  --rm
  --name
  schwab-web
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  SCHWAB_LOGIN_ID
  -e
  SCHWAB_PASSWORD
  -v
  <TMP>/w-schwab-web/home/.secrets:/secrets
  -v
  <TMP>/w-schwab-web/xdgdata/wealthdb/schwab-web:/data
  -v
  <TMP>/w-schwab-web/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-schwab-web/xdgcache/wealthdb/schwab-web:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-schwab-web/xdgcache/wealthdb/debug/schwab-web:/debug
  -v
  <TMP>/w-schwab-web/tree/collectors/schwab-web:/app
  wealthdb/schwab-web:latest
  vnc-login
  [env] SCHWAB_LOGIN_ID=<unset>
  [env] SCHWAB_PASSWORD=<unset>
exit: 0
