=== build
--- calls
python3
  -
  <TMP>/w-schwab-api/tree/collectors/schwab-api
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/schwab-api:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
  wealthdb/schwab-api:latest
  <TMP>/w-schwab-api/tree/collectors/schwab-api
exit: 0
