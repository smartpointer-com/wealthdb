=== vnc-login
--- calls
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^schwab-api$
  --filter
  status=running
  -q
docker
  rm
  -f
  schwab-api
docker
  run
  --rm
  --name
  schwab-api
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  SCHWAB_CLIENT_ID
  -e
  SCHWAB_CLIENT_SECRET
  -e
  SCHWAB_LOGIN_ID
  -e
  SCHWAB_PASSWORD
  -v
  <TMP>/w-schwab-api/home/.secrets:/secrets
  -v
  <TMP>/w-schwab-api/xdgdata/wealthdb/schwab-api:/data
  -v
  <TMP>/w-schwab-api/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-schwab-api/xdgcache/wealthdb/schwab-api:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-schwab-api/xdgcache/wealthdb/debug/schwab-api:/debug
  wealthdb/schwab-api:latest
  vnc-login
  [env] SCHWAB_CLIENT_ID=<unset>
  [env] SCHWAB_CLIENT_SECRET=<unset>
  [env] SCHWAB_LOGIN_ID=<unset>
  [env] SCHWAB_PASSWORD=<unset>
exit: 0
