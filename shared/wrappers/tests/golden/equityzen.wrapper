=== explore
--- calls
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^equityzen$
  --filter
  status=running
  -q
docker
  rm
  -f
  equityzen
docker
  run
  --rm
  --name
  equityzen
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  EQUITYZEN_USERNAME
  -e
  EQUITYZEN_EMAIL
  -e
  EQUITYZEN_PASSWORD
  -v
  <TMP>/w-equityzen/home/.secrets:/secrets
  -v
  <TMP>/w-equityzen/xdgdata/wealthdb/equityzen:/data
  -v
  <TMP>/w-equityzen/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-equityzen/xdgcache/wealthdb/equityzen:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-equityzen/xdgcache/wealthdb/debug/equityzen:/debug
  -v
  <TMP>/w-equityzen/tree/collectors/equityzen:/app
  wealthdb/equityzen:latest
  explore
  [env] EQUITYZEN_USERNAME=<unset>
  [env] EQUITYZEN_EMAIL=<unset>
  [env] EQUITYZEN_PASSWORD=<unset>
exit: 0
