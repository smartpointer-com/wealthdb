=== login
--- calls
docker
  ps
  --filter
  name=^firstcitizens$
  --filter
  status=running
  -q
docker
  rm
  -f
  firstcitizens
docker
  run
  --rm
  --name
  firstcitizens
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  FIRSTCITIZENS_USERNAME
  -e
  FIRSTCITIZENS_PASSWORD
  -v
  <TMP>/w-firstcitizens/home/.secrets:/secrets
  -v
  <TMP>/w-firstcitizens/xdgdata/wealthdb/firstcitizens:/data
  -v
  <TMP>/w-firstcitizens/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-firstcitizens/xdgcache/wealthdb/firstcitizens:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-firstcitizens/xdgcache/wealthdb/debug/firstcitizens:/debug
  -v
  <TMP>/w-firstcitizens/tree/collectors/firstcitizens:/app
  wealthdb/firstcitizens:latest
  login
  [env] FIRSTCITIZENS_USERNAME=<unset>
  [env] FIRSTCITIZENS_PASSWORD=<unset>
exit: 0
