=== login
--- calls
exit: 0
--- stdout
--- stderr
erstebank_at: 'login' folds into 'download', which signs in only when no session is alive (§F).
  Run 'download' (one-shot sign-in + fetch), or 'login --check' to probe a session.
=== vnc-login
--- calls
docker
  image
  inspect
  --format
  {{.Id}}
  wealthdb/erstebank_at:latest
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^erstebank_at$
  --filter
  status=running
  -q
docker
  rm
  -f
  erstebank_at
docker
  run
  --rm
  --pull=never
  --name
  erstebank_at
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  ERSTEBANK_AT_USERNAME
  -v
  <TMP>/w-erstebank_at/home/.secrets:/secrets
  -v
  <TMP>/w-erstebank_at/xdgdata/wealthdb/erstebank_at:/data
  -v
  <TMP>/w-erstebank_at/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-erstebank_at/xdgcache/wealthdb/erstebank_at:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-erstebank_at/xdgcache/wealthdb/debug/erstebank_at:/debug
  -v
  <TMP>/w-erstebank_at/tree/collectors/erstebank_at:/app
  wealthdb/erstebank_at:latest
  vnc-login
  [env] ERSTEBANK_AT_USERNAME=<unset>
exit: 0
