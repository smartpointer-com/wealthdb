=== build
--- calls
python3
  -
  <TMP>/w-angellist/tree/collectors/angellist/Dockerfile
  <TMP>/w-angellist/tree/collectors/angellist/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/angellist:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
  wealthdb/angellist:latest
  <TMP>/w-angellist/tree/collectors/angellist
exit: 0
