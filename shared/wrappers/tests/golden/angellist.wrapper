=== explore
--- calls
lsof
  -nP
  -iTCP:5900
  -sTCP:LISTEN
docker
  ps
  --filter
  name=^angellist$
  --filter
  status=running
  -q
docker
  rm
  -f
  angellist
docker
  run
  --rm
  --name
  angellist
  -p
  127.0.0.1:5900:5900
  -e
  VNC_HOST_PORT=5900
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  ANGELLIST_USERNAME
  -e
  ANGELLIST_PASSWORD
  -v
  <TMP>/w-angellist/home/.secrets:/secrets
  -v
  <TMP>/w-angellist/xdgdata/wealthdb/angellist:/data
  -v
  <TMP>/w-angellist/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-angellist/xdgcache/wealthdb/angellist:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-angellist/xdgcache/wealthdb/debug/angellist:/debug
  -v
  <TMP>/w-angellist/tree/collectors/angellist:/app
  wealthdb/angellist:latest
  explore
  [env] ANGELLIST_USERNAME=<unset>
  [env] ANGELLIST_PASSWORD=<unset>
exit: 0
