=== login
--- calls
docker
  run
  --rm
  --name
  ubs-web
  --user
  <UID>:<GID>
  -e
  HOME=/tmp
  -e
  UBS_CONTRACT_NUMBER
  -v
  <TMP>/w-ubs-web/home/.secrets:/secrets
  -v
  <TMP>/w-ubs-web/xdgdata/wealthdb/ubs-web:/data
  -v
  <TMP>/w-ubs-web/xdgcache/wealthdb/startupcache:/cache/startupcache
  -e
  WEALTHDB_STARTUPCACHE_DIR=/cache/startupcache
  -v
  <TMP>/w-ubs-web/xdgcache/wealthdb/ubs-web:/cache/collector
  -e
  WEALTHDB_CACHE_DIR=/cache/collector
  -v
  <TMP>/w-ubs-web/xdgcache/wealthdb/debug/ubs-web:/debug
  wealthdb/ubs-web:latest
  login
  [env] UBS_CONTRACT_NUMBER=<unset>
exit: 0
