=== build
--- calls
python3
  -
  <TMP>/w-chase/tree/collectors/chase/Dockerfile
  <TMP>/w-chase/tree/collectors/chase/requirements.txt
  --
  missing
docker
  image
  inspect
  -f
  {{index .Config.Labels "wealthdb.inputs"}}
  wealthdb/chase:latest
docker
  build
  --provenance=false
  --build-arg
  WEALTHDB_IMAGE_TAG=latest
  -t
  wealthdb/chase:latest
  <TMP>/w-chase/tree/collectors/chase
exit: 0
