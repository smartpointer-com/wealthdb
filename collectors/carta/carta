#!/bin/bash
# Host-side wrapper around `docker run` for the carta
# container. Mounts ~/.secrets/ (RW; persistent Camoufox profile + env
# file), the bronze tree (RW), and a /debug dir for explore-phase
# artefacts. Single-writer: the holder session cookie + 2FA prompts can't
# tolerate concurrent invocations.
#
# `explore` forwards a free 5900-6000 host port so the live Camoufox
# session can be driven over VNC; login + download + load run headlessly.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=carta
ENV_PREFIX=CARTA
ENV_VARS=(CARTA_USERNAME CARTA_EMAIL CARTA_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount while iterating on explore.py
HAS_SAFETY=1        # refuse to evict a live container mid-2FA / mid-VNC
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore)   # replaces the default {vnc-login} — no vnc-login verb here

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
carta — host wrapper

Implemented end-to-end: \`login\` (Camoufox SPA login + CLI 2FA) ->
\`download\` (authenticated REST/JSON walk + document archive) ->
\`load\` (event-dated silver deltas). See DESIGN.md and README.md.

Subcommands:
  build               Build the Docker image (\`docker build\`).
  explore [args...]   Discovery harness: launch Camoufox in the
                      container's Xvfb display and expose a VNC port for
                      driving the live holder UI interactively; record
                      HAR + Playwright trace + click log + saved blobs
                      under /debug for analysis. --fresh wipes the
                      profile so the next login forces 2FA.
  login [args...]     Mint a Carta holder session via the SPA login form.
                      Prompts for the 2FA code on stdin; the Camoufox
                      profile in /secrets/carta-profile keeps future runs
                      from re-prompting (exact cookie lifetime not measured).
                      --check probes the existing session without firing a
                      2FA push.
  download [args...]  Capture bronze for both holding families: the
                      cap-table side (holdings, grants, vesting, per-grant
                      exercise-detail xlsx) and the fund-LP side (capital
                      account, cap calls), plus the document archive
                      (statements, notices, K-1 / 1042-S tax docs). Writes
                      a UTC-timestamped subdir + run.json manifest under
                      the data dir ($HOST_DATA). --dry-run verifies
                      discovery without writing; --no-documents skips the
                      document pass (the run's dominant cost).
  load [args...]      Ingest bronze snapshots into the SQLite silver:
                      entities, securities, vesting_schedules +
                      vesting_events, fund_metrics, cap_calls,
                      capital_events, cash_flows, documents.
                      --force deletes the silver DB and rebuilds from all bronze.
  prune [args...]     Delete non-complete dumps (a crashed walk left
                      run.json status="in-progress", or a pre-status run
                      left no run.json) from the bronze tree. Runs
                      host-side (pure file walk; no container), so it can
                      reclaim disk while a download is mid-flight. Also
                      strips screenshots/ (the download --debug captures)
                      from complete dumps; their load inputs are never
                      touched. --dry-run prints the plan without deleting
                      anything.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  CARTA_SECRETS_DIR=/path/to/secrets
  CARTA_DATA_DIR=/path/to/data
  CARTA_DEBUG_DIR=/path/to/debug

Credentials:
  CARTA_USERNAME (or the legacy CARTA_EMAIL) / CARTA_PASSWORD are read
  from /secrets/carta.env inside
  the container (= \$HOME/.secrets/carta.env on the host). chmod 0600.
  The 2FA code is prompted on stdin during \`login\`; the session that
  lands in /secrets/carta-profile/ keeps future logins from firing a 2FA
  push (exact persistence lifetime not measured).
EOF
    exit 0
fi

# `./carta prune [args...]` → host-side python invocation.
#
# prune is a pure file walk (collectorkit.prune + stdlib) — no browser, no
# poppler, no container. carta's `load` runs in-container ONLY because it
# needs poppler-utils (pdftotext) to parse statement PDFs; prune has no such
# dependency, so per the collectors/ prune convention it runs host-side.
# Host-side execution also bypasses the single-writer safety guard, so disk
# can be reclaimed while a `download`/`login` container is mid-2FA/mid-walk
# (the in-flight dump is protected by prune's own --min-age-hours guard).
# The default --bronze-dir comes first so an explicit flag in [args...]
# overrides it (argparse last-wins).
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
