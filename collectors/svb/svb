#!/usr/bin/env bash
# svb — host wrapper for the wealthdb "svb" collector.
#
# A one-shot historical sideload: it parses a static archive of SVB statement
# PDFs — brokerage, deposit and mortgage — into silver SQLites that use the
# fidelity-web schema, so the shared Fidelity gold adapter projects them, one
# gold source id per family. SVB wound down in 2023; there is no live source to
# log into and nothing to download on a schedule — the statements are a fixed
# archive dropped into the data dir — so `login` and `download` are no-ops.
# Host-venv collector (no Docker).
#
# Subcommands:
#   load [args...]      Rebuild the silver DBs from the statement PDFs in the
#                       data dir — one per statement family, each a gold source
#                       of its own (svb, svb-deposit, svb-mortgage).
#   download | login    No-op (explains the sideload model).
#   prune               No-op. The bronze holds the load-input statement PDFs
#                       themselves — no timestamped run dirs and no debug
#                       artefacts to reclaim — so there is nothing to prune and
#                       the PDFs are never deleted.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on `load`:
#   --data-dir  DIR     data dir; PDFs under <data-dir>/bronze/, searched
#                       recursively (default $XDG_DATA_HOME/wealthdb/svb)
#   --silver-db PATH    brokerage silver DB path (default <data-dir>/svb.db);
#                       the deposit and mortgage DBs sit beside it
# Extra `load` flags pass through to load.py (e.g. --statement-signature).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=svb
ENV_PREFIX=SVB
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
    -h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"
        exit 0
        ;;
    download|login)
        # --check is accepted for fleet uniformity; this collector is load-only
        # with no session, so there is nothing for it to probe.
        case " $* " in *" --check "*) echo "svb: login --check is a no-op; there is no session to probe." >&2 ;; esac
        cat >&2 <<'EOF'
svb: no-op. This collector has no live source — the SVB statements are a fixed
historical archive (SVB wound down in 2023). Drop the in-scope statement PDFs
(+ an optional signature.txt page-1 guard, and the derived-marks.xlsx advisor
workbook where the archive has interior gaps) into <data-dir>/bronze/ (default
$XDG_DATA_HOME/wealthdb/svb/bronze/), in whatever folder layout suits — load
searches it recursively — then run `./svb load` to rebuild the silver DBs from
them.
EOF
        exit 0
        ;;
    prune)
        # Acknowledge any flags rather than swallowing them silently.
        [[ $# -gt 0 ]] && echo "svb: prune flags ignored — nothing to reclaim." >&2
        # No prune.py is shipped: the shared collectorkit.prune engine would be
        # inert here anyway (its iter_run_dirs matches only <UTC-ts>/ slugs and
        # never touches bronze-root files). The arm exists so the orchestrator
        # can forward `prune` uniformly without erroring.
        cat >&2 <<'EOF'
svb: prune is a no-op. The bronze holds the SVB statement PDFs (+ an optional
signature.txt and the derived-marks.xlsx advisor workbook) — the load inputs
themselves, git-ignored and the only copy.
There are no timestamped run dirs, no download stage, and no debug artefacts to
reclaim, so there is nothing to prune. The statement PDFs are never deleted.
EOF
        exit 0
        ;;
    load)
        host_resolve_dirs "$cmd" "$@"
        py="$(host_python)"
        exec "$py" "$HERE/load.py" --bronze-dir "$DATA_DIR/bronze" --silver-db "$SILVER_DB" \
            ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
        ;;
    *)
        echo "svb: unknown command '$cmd' (expected: load, download, login, prune, help)" >&2
        exit 2
        ;;
esac
