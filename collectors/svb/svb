#!/usr/bin/env bash
# svb — host wrapper for the wealthdb "svb" collector.
#
# A one-shot historical sideload: it parses a static archive of SVB Wealth
# Advisory / NFS brokerage statement PDFs into a silver SQLite (svb.db) that
# uses the fidelity-web silver schema, so the shared Fidelity gold adapter
# projects it under a separate source id ("svb"). SVB wound down in 2023;
# there is no live source to log into and nothing to download on a schedule —
# the statements are a fixed archive you drop in the data dir — so `login`
# and `download` are no-ops. Host-venv collector (no Docker).
#
# Subcommands:
#   load [args...]      Rebuild svb.db from the statement PDFs in the data dir.
#   download | login    No-op (explains the sideload model).
#   prune               No-op. The bronze is a flat archive of the load-input
#                       statement PDFs — no timestamped run dirs and no debug
#                       artefacts to reclaim — so there is nothing to prune and
#                       the PDFs are never deleted.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on `load`:
#   --data-dir  DIR     data dir; PDFs in <data-dir>/bronze/
#                       (default $XDG_DATA_HOME/wealthdb/svb)
#   --silver-db PATH    silver DB path (default <data-dir>/svb.db)
# Extra `load` flags pass through to load.py (e.g. --closure-date,
# --statement-signature).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=svb
ENV_PREFIX=SVB
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
    -h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"
        exit 0
        ;;
    download|login)
        # F41: --check is accepted for fleet uniformity; this collector is
        # load-only with no session, so --check is inherently a no-op.
        case " $* " in *" --check "*) echo "svb: login --check not implemented (TODO); no session to probe." >&2 ;; esac
        cat >&2 <<'EOF'
svb: no-op. This collector has no live source — the SVB Wealth Advisory
statements are a fixed historical archive (SVB wound down in 2023). Drop the
in-scope statement PDFs (+ an optional signature.txt page-1 guard) into
<data-dir>/bronze/ (default $XDG_DATA_HOME/wealthdb/svb/bronze/), then run
`./svb load` to rebuild svb.db from them.
EOF
        exit 0
        ;;
    prune)
        # F32: prune is a no-op here; acknowledge any flags rather than
        # swallowing them silently.
        [[ $# -gt 0 ]] && echo "svb: prune flags ignored — nothing to reclaim." >&2
        # No-op. Unlike the scraper collectors, svb's bronze is a FLAT archive:
        # the SVB Wealth Advisory statement PDFs (+ an optional signature.txt)
        # sit directly at the bronze root, with no timestamped run dirs and no
        # download stage that could leave debug artefacts. Those PDFs ARE the
        # load inputs — git-ignored, the only copy, irreplaceable — so there is
        # nothing to reclaim and pruning would only risk deleting them. The
        # shared collectorkit.prune engine would be inert here anyway (its
        # iter_run_dirs matches only <UTC-ts>/ slugs and never touches
        # bronze-root files), so no prune.py is shipped. The arm exists so the
        # orchestrator can forward `prune` uniformly without erroring.
        cat >&2 <<'EOF'
svb: prune is a no-op. The bronze is a flat archive of the SVB Wealth Advisory
statement PDFs (+ an optional signature.txt) — the load inputs themselves,
git-ignored and the only copy. There are no timestamped run dirs, no download
stage, and no debug artefacts to reclaim, so there is nothing to prune. The
statement PDFs are never deleted.
EOF
        exit 0
        ;;
    load)
        host_resolve_dirs "$cmd" "$@"
        py="$(host_python)"
        exec "$py" "$HERE/load.py" --bronze-dir "$DATA_DIR/bronze" --silver-db "$SILVER_DB" \
            ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
        ;;
    *)
        echo "svb: unknown command '$cmd' (expected: load, download, login, prune, help)" >&2
        exit 2
        ;;
esac
