#!/usr/bin/env bash
# schwab-api — host wrapper for the wealthdb "schwab-api" collector.
#
# Hybrid collector. The OAuth `login` runs in a Camoufox/VNC container
# (Schwab's 7-day refresh token needs an interactive browser grant);
# `download` and `load` run on the host venv (schwab-py REST + SQLite).
#   build              Build the login Docker image (`docker build`).
#   login [args...]    Automated OAuth refresh in headed Camoufox: pre-fills
#                      the Schwab login from SCHWAB_LOGIN_ID / SCHWAB_PASSWORD
#                      (schwab-web.env), auto-submits, prompts for the 2FA
#                      code on stdin, drives the consent / account-link pages
#                      (ticking every account), and writes the token to
#                      <secrets>/schwab-api-token.json. Traces to the debug
#                      dir. --check inspects the token; --manual is the
#                      paste-the-URL fallback.
#   vnc-login [args..] Manual fallback: drive login / 2FA / consent yourself
#                      over VNC (use if `login`'s selectors drift).
#   download [args...] Fetch accounts / positions / transactions to bronze.
#   load [args...]     Parse bronze into the silver SQLite DB.
#   prune [args...]    Delete non-complete dumps (crashed / interrupted
#                      downloads) from the bronze tree, and aged-out
#                      entries from the login trace cache
#                      (~/.cache/schwab-api-debug). Host-side; --dry-run
#                      prints the plan without deleting.
#   recompress [args]  One-time backlog sweep: replace plain data JSON
#                      (account_numbers / user_preference /
#                      accounts_positions / transactions_NNN /
#                      open_orders / instruments) inside complete dumps
#                      with sha256-verified .json.zst twins — the form
#                      download now writes. run.json is never compressed.
#                      Host-side; manual only, never scheduled; --dry-run
#                      prints the plan first, verify with `load --force`.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on any subcommand:
#   --secrets-dir DIR  credentials + OAuth token  (default ~/.secrets)
#   --data-dir    DIR  bronze dumps root          (default $XDG_DATA_HOME/wealthdb/schwab-api)
#   --silver-db   PATH silver DB path             (default <data-dir>/schwab-api.db)
# The debug/trace cache `login` writes and `prune` reclaims is
# ~/.cache/schwab-api-debug, or $SCHWAB_API_DEBUG_DIR when set.
#
# OAuth app creds (SCHWAB_CLIENT_ID / SCHWAB_CLIENT_SECRET) come from
# <secrets-dir>/schwab-api.env; the Schwab login id/password pre-filled
# into the consent page come from <secrets-dir>/schwab-web.env.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=schwab-api
ENV_PREFIX=SCHWAB_API

cmd="${1:-help}"

case "$cmd" in
    -h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"
        exit 0
        ;;
    build)
        # Docker login image.
        ENV_VARS=()
        HAS_VNC=1
        HAS_DEBUG=1
        HAS_SAFETY=1
        # shellcheck disable=SC1091
        source "$HERE/../../shared/wrappers/wrapper-lib.sh"
        wrapper_init
        wrapper_build "$@"
        ;;
    login|vnc-login)
        # Camoufox OAuth login container. `login` is the automated default
        # (no VNC); `vnc-login` is the manual fallback and gets a forwarded
        # VNC port (wrapper-lib forwards it only for the 'vnc-login' sub).
        ENV_VARS=(SCHWAB_CLIENT_ID SCHWAB_CLIENT_SECRET \
                  SCHWAB_LOGIN_ID SCHWAB_PASSWORD)
        HAS_VNC=1           # vnc-login → forward a free 5900-6000 port
        HAS_DEBUG=1         # /debug for the trace + page captures
        HAS_SAFETY=1        # don't evict a live VNC / 2FA session
        # shellcheck disable=SC1091
        source "$HERE/../../shared/wrappers/wrapper-lib.sh"
        wrapper_init
        wrapper_main "$@"   # the sub ($1) → entrypoint dispatches it
        ;;
    download|load|prune|recompress)
        # Host venv (schwab-py REST + SQLite). `prune` and `recompress`
        # are siblings of `load`: pure file walks, no container, run
        # under the same venv (collectorkit is editable-installed there,
        # so `from collectorkit import prune` resolves with no PYTHONPATH
        # hack). `recompress` is the one-time manual sweep converting the
        # pre-compression backlog to the .json.zst form download now
        # writes. `prune` walks the bronze tree plus the trace cache the
        # containerised `login` writes — DEBUG_DIR resolves the same there
        # as it does in wrapper-lib, so both halves name one dir. The
        # default dir flags come first so an explicit flag in the
        # forwarded args overrides them (argparse last-wins); in-flight
        # dumps and captures are protected by the verb's own age guard.
        # shellcheck disable=SC1091
        source "$HERE/../../shared/wrappers/host-lib.sh"
        shift
        host_resolve_dirs "$cmd" "$@"
        host_source_env_file
        py="$(host_python)"
        token="$SECRETS_DIR/schwab-api-token.json"
        case "$cmd" in
            download)
                exec "$py" "$HERE/download.py" --token-path "$token" \
                    --bronze-dir "$DATA_DIR" \
                    ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
                ;;
            load)
                exec "$py" "$HERE/load.py" --silver-db "$SILVER_DB" \
                    --bronze-dir "$DATA_DIR" \
                    ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
                ;;
            prune)
                exec "$py" "$HERE/prune.py" --bronze-dir "$DATA_DIR" \
                    --debug-dir "$DEBUG_DIR" \
                    ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
                ;;
            recompress)
                exec "$py" "$HERE/recompress.py" --bronze-dir "$DATA_DIR" \
                    ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
                ;;
        esac
        ;;
    *)
        echo "schwab-api: unknown command '$cmd' (expected: build|login|vnc-login|download|load|prune|recompress)" >&2
        exit 2
        ;;
esac
