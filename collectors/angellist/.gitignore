# Python, test, editor and OS artefacts are ignored by the root
# .gitignore. This file adds what this collector must never commit.

# Playwright / Camoufox debugging artefacts — may contain logged-in
# screenshots or session state. Never commit.
trace*.zip
trace-chunks/
screenshots/
playwright-report/
network.har
network.jsonl
clicks.jsonl

# Never commit credentials, browser profiles, session cookies, or
# downloaded portfolio data. The default mount layout puts these on the
# host under ~/.secrets/ and $XDG_DATA_HOME/wealthdb/angellist/ respectively, but a
# stray in-tree drop must still be blocked.
*.pem
*.key
storageState*.json
angellist-session*.json
angellist-profile/
token.json
tokens.json
.env
.envrc
data/
downloads/

# Bronze / silver default in-tree paths in case someone overrides the
# mount layout to put the data tree under the repo.
bronze/
silver/
*.db
*.db-journal
*.db-wal
*.db-shm

# Bootstrap material dropped in for landmarking (sample HTML,
# screenshots, MHTML saves of the Investor Portal UI). These contain
# real LP names, SPV/fund names, and commitment amounts and must never
# be committed. Move them into a tracked location only after redaction.
samples/
fixtures/raw/
*.mhtml
*.har

# Tax documents (K-1s, capital-account statements) are the most
# sensitive artefacts this collector touches — raw PDFs carry the LP's
# legal name, SSN/EIN fragments, and per-vehicle dollar figures. They
# land under the host data tree; block any in-tree drop outright.
*.pdf
k1s/
tax-documents/
angellist-documents/

# Local-only HTML / CSV / JSON fixtures for the smoke-test suite. Real
# AngelList exports contain PII; only synthetic data goes into version
# control.
tests/fixtures/*.csv
tests/fixtures/*.html
tests/fixtures/*.json
