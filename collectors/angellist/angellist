#!/bin/bash
# Host-side wrapper around `docker run` for the angellist
# container. Mounts ~/.secrets/ (RW; persistent browser profile + env
# file), the bronze tree (RW), and a /debug dir for explore-phase
# artefacts. Single-writer: the Investor Portal session cookie + 2FA
# prompts can't tolerate concurrent invocations.
#
# `explore` and `login` forward a free 5900-6000 host port so the live
# browser can be driven over VNC; download + load run headlessly.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=angellist
ENV_PREFIX=ANGELLIST
ENV_VARS=(ANGELLIST_USERNAME ANGELLIST_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount while iterating on explore.py
HAS_SAFETY=1        # refuse to evict a live container mid-2FA / mid-VNC
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore login)   # extends the default {vnc-login}

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    cat <<EOF
angellist — host wrapper

Implemented end-to-end: \`login\` (real-Firefox cookie lift) ->
\`download\` (Camoufox + injected cookie, GraphQL capture + tax-doc fetch)
-> \`load\` (event-sourced silver). See DESIGN.md and README.md.

Subcommands:
  build               Build the Docker image (\`docker build\`).
  explore [args...]   Discovery harness: launch Camoufox in the
                      container's Xvfb display and expose a VNC port for
                      driving the live Investor Portal interactively;
                      record HAR + Playwright trace + click log + saved
                      blobs under /debug for analysis. --fresh wipes the
                      profile so the next login forces 2FA.
  login [args...]     The auth path (formerly byo-login). If the saved
                      profile still holds a valid session — cookie unexpired
                      AND a headless probe confirms the server still accepts
                      it — the cookie is lifted and login exits at once, no VNC.
                      Otherwise launch a genuine, stock Mozilla Firefox under
                      VNC so you clear AngelList's invisible anti-bot login by
                      hand (+2FA; the Camoufox/Playwright stack gets flagged);
                      on a clean Firefox close, the session is lifted from its
                      plaintext cookies.sqlite into
                      /secrets/angellist-cookies.json for download to inject.
                      The tool types no credentials — you log in yourself;
                      there is no unattended login.
                        --check   probe only; exit 0 if the saved session is
                                  valid, 1 otherwise — never opens Firefox.
                        --force   skip the check and always re-login.
  download [args...]  Capture bronze for every LP investment: portfolio
                      summary, per-vehicle detail (commitment / called /
                      FMV / distributions), the funding-account cash ledger,
                      and the commitments — plus download the tax documents
                      (K-1 CSV/PDF, financial statements). Writes a
                      UTC-timestamped subdir + run.json manifest under the
                      data dir ($HOST_DATA). --dry-run walks the
                      navigation without writing bronze or downloading docs.
  load [args...]      Ingest bronze + tax docs into the SQLite silver:
                      offerings + position_snapshots, vehicles,
                      portfolio_summary / timeseries, commitments,
                      funding_accounts + funding_transactions,
                      k1_capital_accounts, tax_documents.
                      --force re-loads snapshots already in dump_runs.
  prune [args...]     Delete non-complete dumps (crashed / interrupted
                      downloads that never wrote a terminal run.json)
                      from the bronze tree. Runs host-side (pure stdlib;
                      no Docker spawn), so it can reclaim disk while a
                      download is mid-flight — the in-flight dump is
                      protected by prune's own age guard. --dry-run prints
                      the plan without deleting anything.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  ANGELLIST_SECRETS_DIR=/path/to/secrets
  ANGELLIST_DATA_DIR=/path/to/data
  ANGELLIST_DEBUG_DIR=/path/to/debug

Credentials:
  \`login\` opens a real Firefox you drive by hand — enter your username /
  password / 2FA in the browser yourself; the tool types nothing. On a clean
  close the session cookie is lifted to /secrets/angellist-cookies.json
  (= \$HOME/.secrets/angellist-cookies.json on the host; chmod 0600), which
  \`download\` injects (cookie lifetime ~27 days). The \`explore\` discovery
  harness can pre-fill the SPA login from ANGELLIST_USERNAME /
  ANGELLIST_PASSWORD in /secrets/angellist.env.
EOF
    exit 0
fi

# `./angellist prune [args...]` → host-side python invocation.
#
# Like fidelity-web's `load`/`prune`: a pure file walk needs no
# container, and running it host-side bypasses the single-writer safety
# guard so it can reclaim disk while a `download` container is mid-flight
# (the in-flight dump is protected by prune's own age guard). prune.py +
# collectorkit.prune/bronze are pure stdlib. The default --bronze-dir
# comes first so an explicit flag in [args...] overrides it (argparse
# last-wins). --bronze-dir points at the bronze ROOT ($HOST_DATA); the
# engine iterates only timestamped run dirs, so the sibling
# angellist-documents/ tree and the silver angellist.db are never
# touched.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
