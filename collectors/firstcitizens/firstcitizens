#!/bin/bash
# Host-side wrapper around `docker run` for the firstcitizens container.
# Mounts ~/.secrets/ (RW; persistent Camoufox profile + env file + session
# state), the bronze tree (RW), and a /debug dir for explore/login
# artefacts. Single-writer: the session cookie + 2FA prompts can't tolerate
# concurrent invocations, and the safety guard refuses to evict a container
# hosting a live VNC session.
#
# The logon must run in the browser (Akamai gates preLogonUser/logonUser —
# DESIGN.md §3), so `login` and `download` both drive Camoufox: `login` is
# interactive (device registration, terminal 2FA), `download` unattended
# (trusted device skips 2FA, then a REST fetch). `load` ingests bronze into
# the SQLite silver; `prune` is a pure file walk that runs host-side.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=firstcitizens
ENV_PREFIX=FIRSTCITIZENS
ENV_VARS=(FIRSTCITIZENS_USERNAME FIRSTCITIZENS_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount during iteration
HAS_SAFETY=1        # refuse to evict a live container mid-2FA / mid-VNC
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore vnc-login)   # the browser-over-VNC verbs

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
firstcitizens — host wrapper

Read-only scraper for the First Citizens Bank retail deposit relationship
(checking / savings) over the Q2 mobilews REST API. \`login\` registers the
device once (interactive 2FA); \`download\` then runs unattended and fetches
each deposit account's activity + statement PDFs. \`load\` ingests that
bronze into the SQLite silver. See DESIGN.md for the mapped flows.

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Interactive login: pre-fills + submits the sign-in
                      form, then drives 2FA from the TERMINAL (text / call).
                      Registers the device so \`download\` runs unattended.
                      \`login --check\` reports whether the trusted-device
                      logon still skips 2FA (sends no code).
  vnc-login [args...] Fallback for login: exposes VNC for a by-hand 2FA.
                      Add --fresh to force the untrusted-device flow (wipes
                      the stored device-trust so the full 2FA fires).
  download [args...]  Unattended logon (trusted device, no 2FA) + REST fetch
                      of the deposit accounts (roster, history, exports,
                      statement PDFs) into a UTC-stamped bronze run dir.
                      --format picks export formats; --no-documents skips
                      statements; --dry-run enumerates without exporting.
  load [args...]      Ingest bronze into the SQLite silver.
  prune [args...]     Delete non-complete dumps from the bronze tree (runs
                      host-side). --dry-run prints the plan.
  explore [args...]   Discovery harness: Camoufox over VNC + HAR / network
                      log / click log / DOM snapshots under /debug. --fresh
                      wipes the profile so the next login forces a full 2FA.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  FIRSTCITIZENS_SECRETS_DIR=/path/to/secrets
  FIRSTCITIZENS_DATA_DIR=/path/to/data
  FIRSTCITIZENS_DEBUG_DIR=/path/to/debug

Credentials:
  FIRSTCITIZENS_USERNAME / FIRSTCITIZENS_PASSWORD are read from
  /secrets/firstcitizens.env inside the container
  (= \$HOME/.secrets/firstcitizens.env on the host). chmod 0600.
  The 2FA challenge is driven from the terminal (\`login\`) or by hand
  over VNC (\`vnc-login\`).
EOF
    exit 0
fi

# prune is a pure file walk (collectorkit.prune + stdlib) — no browser, no
# container. Run it host-side like the other collectors so it bypasses the
# single-writer safety guard and can reclaim disk while a download is
# mid-flight (its own --min-age guard protects an in-flight dump). With
# HAS_DEBUG=1 the wrapper also passes --debug-dir so the /debug cache is
# reclaimed.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
