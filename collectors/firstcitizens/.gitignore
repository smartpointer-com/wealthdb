# Python build artefacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
*.egg

# Virtual environments (this collector runs entirely inside Docker, but
# editors sometimes create these for LSP convenience)
.venv/
venv/
env/
.python-version

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Playwright / Camoufox debugging artefacts — may contain logged-in
# screenshots or session state. Never commit.
trace*.zip
trace-chunks/
screenshots/
playwright-report/
network.har
network.jsonl
clicks.jsonl

# Never commit credentials, browser profiles, session cookies, or
# downloaded account data. The default mount layout puts these on the
# host under ~/.secrets/, ~/.cache/wealthdb/debug/firstcitizens/, and
# $XDG_DATA_HOME/wealthdb/firstcitizens/ respectively, but a stray
# in-tree drop must still be blocked.
*.pem
*.key
storageState*.json
firstcitizens-session*.json
firstcitizens-profile/
token.json
tokens.json
.env
.envrc
data/
downloads/

# Bronze / silver default in-tree paths in case someone overrides the
# mount layout to put the data tree under the repo.
bronze/
silver/
*.db
*.db-journal
*.db-wal
*.db-shm

# Bootstrap material dropped in for landmarking (sample HTML, MHTML
# saves of the account UI). These contain real account numbers, balances,
# and payees and must never be committed. Move them into a tracked
# location only after redaction.
samples/
fixtures/raw/
*.mhtml
*.har

# Statement PDFs and transaction exports are the most sensitive artefacts
# this collector will touch — account/routing numbers, balances, payees,
# names, and addresses. They land under the host debug/data trees; block
# any in-tree drop outright.
*.pdf
*.ofx
*.qfx
*.qbo
statements/
exports/

# Local-only fixtures holding real captures; only synthetic data goes
# into version control.
tests/fixtures/raw/
tests/fixtures/*.csv
tests/fixtures/*.html
tests/fixtures/*.json
