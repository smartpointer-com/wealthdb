#!/bin/bash
# Host-side wrapper around `docker run` for the viac container.
# Mounts ~/.secrets/ (RW for the cookie-jar state file), the bronze
# tree (RW), and the wrapper directory at /app for live-code reload
# during iteration. The common docker-run plumbing lives in
# shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=viac
ENV_PREFIX=VIAC
ENV_VARS=(VIAC_LOGIN VIAC_PASSWORD)
HAS_APP_MOUNT=1     # /app live-mount during iteration
HAS_SAFETY=1        # named container; refuse to clobber a live login

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    cat <<EOF
viac — host wrapper

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Mint or refresh the session cookie jar +
                      CSRF metadata. Use --check for a cheap
                      liveness probe (no MFA push).
  download [args...]  Bronze dump. Use --dry-run to walk JSON
                      endpoints without fetching PDFs;
                      --with-transaction-documents to also pull
                      the per-event TRANSACTION PDFs (adds ~950
                      docs to the run).
  load [args...]      Parse bronze into the silver SQLite DB.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  VIAC_SECRETS_DIR=/path/to/secrets
  VIAC_DATA_DIR=/path/to/data

Credentials:
  VIAC_LOGIN (E.164 mobile number, e.g. +CC<digits>) and
  VIAC_PASSWORD are read from /secrets/viac.env automatically
  (= \$HOME/.secrets/viac.env on the host). Use SINGLE quotes
  around values containing \$, \!, backtick.

Container concurrency:
  Only one viac container runs at a time (fixed name
  '$CONTAINER_NAME'). The wrapper refuses to clobber a RUNNING
  container — set VIAC_FORCE_REPLACE=1 to override.
EOF
    exit 0
fi

wrapper_main "$@"
