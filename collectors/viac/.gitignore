# Python, test, editor and OS artefacts are ignored by the root
# .gitignore. This file adds what this collector must never commit.

# Linux coredumps; the root .gitignore covers a plain `core`. The
# toolkit is REST-only (no browser, no Xvfb), so none is expected; the
# pattern catches the unexpected.
core.*

# Network-capture artefacts. The toolkit is REST-only and doesn't
# emit these, but a one-off curl --trace or browser save-as could.
*.har
*.mhtml

# Never commit credentials or downloaded portfolio data. The
# default mount layout puts these on the host under ~/.secrets/
# and $XDG_DATA_HOME/wealthdb/viac/ respectively, but a stray in-tree drop
# must still be blocked.
*.pem
*.key
viac-state*.json
viac_state*.json
token.json
tokens.json
.env
.envrc
data/
downloads/

# Bronze / silver default in-tree paths in case someone overrides
# the mount layout to put the data tree under the repo.
bronze/
silver/
viac-discovery/
*.db
*.db-journal
*.db-wal
*.db-shm

# Bootstrap material dropped in for landmarking (sample HTML,
# JSON responses, screenshots, MHTML saves of app.viac.ch). These
# contain real account data and must never be committed. Move them
# into a tracked location only after redaction.
samples/
fixtures/raw/

# Local-only PDF / HTML / JSON fixtures for the smoke-test suite.
# Real VIAC artefacts contain PII; only synthetic data goes into
# version control.
tests/fixtures/*.pdf
tests/fixtures/*.html
tests/fixtures/*.json
