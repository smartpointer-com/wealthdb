#!/usr/bin/env bash
# fred — host wrapper for the wealthdb "fred" collector.
#
# Host-venv collector (no Docker): runs the collector's own .py under its
# .venv, like ubs-psn. Pulls daily USD-centric FX reference rates (US Fed
# H.10) from the FRED API. Subcommands:
#   login               No-op (FRED uses an API key, not a session). The
#                       key is read from FRED_API_KEY. `login --check`
#                       probes it: it asks FRED for one observation, so a
#                       key that is present but rejected fails here.
#   download [args...]  Fetch FX rates into bronze. Bound the window with
#                       --lookback (default ~90 days; `--lookback all` or
#                       `--lookback 1971-01-01` for a full historic
#                       backfill).
#   load [args...]      Parse bronze into the silver SQLite DB.
#   prune [args...]     Delete non-complete (crashed / in-flight) bronze run
#                       dirs; complete dumps are kept. --dry-run to preview.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on any subcommand:
#   --secrets-dir DIR   API-key env file          (default ~/.secrets)
#   --data-dir    DIR   bronze dumps root          (default $XDG_DATA_HOME/wealthdb/fred)
#   --silver-db   PATH  silver DB path             (default <data-dir>/fred.db)
# The API key is read from FRED_API_KEY, auto-sourced from
# <secrets-dir>/fred.env (override the path with $FRED_ENV_FILE).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=fred
ENV_PREFIX=FRED
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
    -h|--help|help)
        awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"
        exit 0
        ;;
esac

host_resolve_dirs "$cmd" "$@"
host_source_env_file
py="$(host_python)"

case "$cmd" in
    login)
        # FRED mints no session — the API key IS the credential — so a bare
        # `login` is a no-op. `--check` is a real probe: download.py resolves
        # the key and asks FRED for one observation, so a key that is present
        # but rejected fails here rather than at the next download.
        case " ${FORWARD_ARGS[*]-} " in
            *" --check "*)
                exec "$py" "$HERE/download.py" \
                    ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
                ;;
        esac
        cat >&2 <<'EOF'
fred: no-op. FRED is an API-key-authenticated REST source — there is no
interactive login / session to mint. Put your key in ~/.secrets/fred.env
(FRED_API_KEY=...), then run `./fred download`. To verify the key is
accepted, run `./fred login --check`.
EOF
        exit 0
        ;;
    download)
        exec "$py" "$HERE/download.py" --bronze-dir "$DATA_DIR" \
            ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
        ;;
    load)
        exec "$py" "$HERE/load.py" --silver-db "$SILVER_DB" \
            --bronze-dir "$DATA_DIR" \
            ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
        ;;
    prune)
        exec "$py" "$HERE/prune.py" --bronze-dir "$DATA_DIR" \
            ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
        ;;
    *)
        echo "fred: unknown command '$cmd' (expected: login|download|load|prune)" >&2
        exit 2
        ;;
esac
