playwright.chromium.launch(headless=True, args=['--disk-cache-size=1', '--media-cache-size=1', '--disable-gpu-shader-disk-cache', '--no-sandbox', '--disable-dev-shm-usage', '--disable-blink-features=AutomationControlled'])
browser.new_context(storage_state='<root>/state.json', user_agent='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/159.0.0.0 Safari/537.36', accept_downloads=True)
context.on('request', <fn>)
context.new_page()
page.set_default_navigation_timeout(60000)
page.goto('https://ebanking-ch.ubs.com/workbench/WorkbenchOpenAction.do', wait_until='domcontentloaded')
page.wait_for_function('() => /\\/app\\/.*\\/ebanking\\/spa\\.html/.test(location.href) ||       !!document.querySelector(\'input[name="loginalias"]\')', timeout=30000)
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/home', wait_until='domcontentloaded')
page.wait_for_selector('a[href*="cash-account-transactions"][href*="accountId="]', timeout=30000)
page.evaluate(<text a0d80118b417>, 'a[href*="cash-account-transactions"][href*="accountId="]')
page.route(re.compile('^https://ebanking\\-ch1\\.ubs\\.com/(?:assetview/|api/v3/cash-accounts(?![\\w-]))'), <fn>)
page.on('response', <fn>)
page.expect_response(<fn>, timeout=30000)
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/accounts?target=cash-account-information&navitemid=AccountsAndCardsAccountInformation&accountId=tok-a', wait_until='domcontentloaded')
page.expect_response(<fn>, timeout=30000).value.json()
page.expect_response(<fn>, timeout=30000)
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/accounts?target=cash-account-information&navitemid=AccountsAndCardsAccountInformation&accountId=tok-b', wait_until='domcontentloaded')
page.expect_response(<fn>, timeout=30000).value.json()
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/assets/asset-view?goto=portfolio-overview&preselectFirstPortfolio=true&navitemid=PortfolioDashboard', wait_until='domcontentloaded')
page.locator('button#portfolio-top-navigation-overview-group')
page.locator('button#portfolio-top-navigation-overview-group').first.click(timeout=30000)
page.locator('li#accountBalances')
page.locator('li#accountBalances').first.click(timeout=30000)
page.locator('iframe[src^="/assetview/ebidispatcher.do?"][src*="tabControl=account_balance"]')
page.locator('iframe[src^="/assetview/ebidispatcher.do?"][src*="tabControl=account_balance"]').first.get_attribute('src', timeout=30000)
page.unroute(re.compile('^https://ebanking\\-ch1\\.ubs\\.com/(?:assetview/|api/v3/cash-accounts(?![\\w-]))'), <fn>)
page.remove_listener('response', <fn>)
context.close()
browser.close()
exit 0
