playwright.chromium.launch(headless=True, args=['--disk-cache-size=1', '--media-cache-size=1', '--disable-gpu-shader-disk-cache', '--no-sandbox', '--disable-dev-shm-usage', '--disable-blink-features=AutomationControlled'])
browser.new_context(storage_state='<root>/state.json', user_agent='ua-synthetic', accept_downloads=True)
context.on('request', <fn>)
context.new_page()
page.set_default_navigation_timeout(60000)
page.goto('https://ebanking-ch.ubs.com/workbench/WorkbenchOpenAction.do', wait_until='domcontentloaded')
page.wait_for_function('() => /\\/app\\/.*\\/ebanking\\/spa\\.html/.test(location.href) ||       !!document.querySelector(\'input[name="loginalias"]\')', timeout=30000)
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/home', wait_until='domcontentloaded')
page.wait_for_selector('a[href*="cash-account-transactions"][href*="accountId="]', timeout=30000)
page.evaluate(<text a0d80118b417>, 'a[href*="cash-account-transactions"][href*="accountId="]')
page.evaluate("() => document.querySelectorAll('dialog[open]').length")
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/home', wait_until='domcontentloaded')
page.wait_for_selector('a[href*="portfolioUid="][href*="bankingRelationId="]', timeout=30000)
page.evaluate(<text b77d31511717>, 'a[href*="portfolioUid="][href*="bankingRelationId="]')
page.evaluate("() => document.querySelectorAll('dialog[open]').length")
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/assets/asset-view/portfolio-overview?bankingRelationId=rel-1&navitemid=PortfolioDashboard&portfolioUid=pf-1', wait_until='domcontentloaded')
page.goto('https://ebanking-ch1.ubs.com/app/OQJ/1/ebanking/spa.html#/assets/asset-view/securitiesTransactions?bankingRelationId=rel-1&navitemid=PortfolioDashboard&portfolioUid=pf-1', wait_until='domcontentloaded')
page.click('button[class*="UWR_ContextSelector"][aria-expanded]:not([aria-disabled="true"])', timeout=30000)
page.wait_for_timeout(1000)
page.eval_on_selector_all('[class*="UWR_ContextSelectorItemTitle_container_"]', "els => els.map(e => (e.innerText || '').trim()).filter(Boolean)")
page.keyboard.press('Escape')
page.wait_for_timeout(1000)
