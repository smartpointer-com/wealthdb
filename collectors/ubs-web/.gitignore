# Python, test, editor and OS artefacts are ignored by the root
# .gitignore. This file adds what this collector must never commit.

# Playwright debugging artefacts — may contain logged-in screenshots
# or session state. Never commit.
trace*.zip
screenshots/
playwright-report/

# Never commit credentials or downloaded portfolio data
*.pem
*.key
storageState*.json
ubs-web-state*.json
ubs_web_state*.json
token.json
tokens.json
.env
.envrc
data/
downloads/

# Bootstrap material dropped in for landmarking (sample HTML,
# screenshots, MHTML saves of the netbanking UI). These contain real
# account data and must never be committed. Move them into a tracked
# location only after redaction.
samples/
fixtures/raw/
*.mhtml
*.har
