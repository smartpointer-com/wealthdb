#!/bin/bash
# Host-side wrapper around `docker run` for the ubs-web container.
# Mounts ~/.secrets/ (RW for the state-file write), the bronze tree
# (RW), and a separate /debug dir for opt-in screenshots / Playwright
# trace bundles / ad-hoc QR PNGs. The common docker-run plumbing lives
# in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=ubs-web
ENV_PREFIX=UBS_WEB
ENV_VARS=(UBS_CONTRACT_NUMBER)
HAS_DEBUG=1

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
ubs-web — host wrapper

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Mint or refresh the session state file.
  download [args...]  Export bronze artefacts from netbanking.
  load [args...]      Parse bronze into the silver SQLite DB.
  prune [args...]     Delete non-complete dumps (crashed walks,
                      --dry-run shells) from the bronze tree.
                      --dry-run prints the plan first.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  UBS_WEB_SECRETS_DIR=/path/to/secrets
  UBS_WEB_DATA_DIR=/path/to/data
  UBS_WEB_DEBUG_DIR=/path/to/debug

Credentials:
  The contract number is read from \$UBS_CONTRACT_NUMBER inside the
  container. The login script sources /secrets/ubs-web.env automatically
  (= \$HOME/.secrets/ubs-web.env on the host), so dropping a single line
  UBS_CONTRACT_NUMBER=<your-contract-no> into that file is enough. The
  bank-level ubs.env is still read as a legacy fallback when no
  ubs-web.env exists.
EOF
    exit 0
fi

# `prune [args...]` runs host-side (like fidelity-web), not in the
# container: a pure file walk needs no image deps, and running host-side
# bypasses the single-writer safety guard so prune can reclaim disk while
# a download container is mid-flight (prune's own --min-age guard protects
# an in-flight dump). --bronze-dir is passed first so an explicit flag in
# [args...] overrides it (argparse last-wins); the container entrypoint
# keeps a `prune)` arm too, for a direct `docker run`.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
