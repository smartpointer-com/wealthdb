#!/usr/bin/env bash
# manual — host wrapper for the wealthdb "manual" collector.
#
# Unlike every other collector, `manual` has NO source to fetch from: the
# bronze CSVs (accounts.csv / positions.csv / valuations.csv /
# cost_basis.csv / exits.csv) are maintained by hand in the data dir (default
# $XDG_DATA_HOME/wealthdb/manual/). accounts.csv, cost_basis.csv and
# exits.csv are optional — without accounts.csv every position lands in one
# default account. So there is no `login` and no `download` — only `load`,
# which validates those CSVs and rebuilds the SQLite silver from them.
# Host-venv collector (no Docker).
#
# Subcommands:
#   load [args...]      Validate the CSVs and rebuild the silver DB.
#   download | login    No-op (explains the manual model).
#   prune [args...]     No-op: manual keeps no bronze run-dirs and writes no
#                       debug artefacts, so there is nothing to reclaim.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on `load`:
#   --data-dir  DIR     bronze CSVs dir  (default $XDG_DATA_HOME/wealthdb/manual)
#   --silver-db PATH    silver DB path   (default <data-dir>/manual.db)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=manual
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
    -h|--help|help)
        # Print the leading comment banner (everything after the shebang up
        # to the first line of code) as help — same idiom as
        # bin/wealthdb-collect, and robust to the banner's line count.
        host_print_banner "${BASH_SOURCE[0]}"
        exit 0
        ;;
    download|login)
        # --check is accepted for fleet uniformity; this collector is
        # load-only with no session, so there is nothing to probe.
        host_has_flag --check ${@+"$@"} && echo "manual: no session to probe — --check has nothing to check here." >&2
        # The `first` lines of setup.txt name the two files every load
        # needs and their folder. A `login` at a terminal ends with the
        # commands that follow it.
        setup_print_first
        if [[ "$cmd" == login ]]; then setup_arm_next login ${@+"$@"}; fi
        cat >&2 <<EOF
manual: no-op. The CSVs are the source of truth, kept by hand. Three
more are optional: accounts.csv gives a position its own tax sleeve and
management style, cost_basis.csv holds the capital paid in over time,
and exits.csv what a position was sold for.
\`${WEALTHDB_COLLECT:-wealthdb-collect} manual load\` checks the files and rebuilds the silver.
README.md has the columns and how to keep them.
EOF
        exit 0
        ;;
    prune)
        # Acknowledge any flags rather than swallowing them silently.
        [[ $# -gt 0 ]] && echo "manual: prune flags ignored — nothing to reclaim." >&2
        cat >&2 <<'EOF'
manual: prune is a no-op — nothing to reclaim. This collector is load-only:
it has no timestamped bronze run-dirs and writes no debug or diagnostic
artefacts (no download, no browser, no capture surface). Bronze is just the
hand-maintained CSVs (positions.csv, valuations.csv and the optional
accounts.csv, cost_basis.csv and exits.csv) sitting flat in the data dir —
they are load's only input and the collector's source of truth, so they are
never deleted. The silver DB (manual.db) is rebuilt from them by `load`
(delete it by hand to reclaim its space).
EOF
        exit 0
        ;;
    load)
        host_resolve_dirs "$cmd" "$@"
        host_run load.py --bronze-dir "$DATA_DIR" --silver-db "$SILVER_DB"
        ;;
    *)
        echo "manual: unknown command '$cmd' (expected: load | download | login | prune | help)" >&2
        exit 2
        ;;
esac
