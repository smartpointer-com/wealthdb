#!/bin/bash
# Host-side wrapper around `docker run` for the schwab-web container.
# Mounts ~/.secrets/ (RW; profile dir + env file), the bronze tree
# (RW), and a /debug dir for opt-in screenshots / traces. Lives
# in single-writer mode (named container, refuse-to-clobber-running
# safety guard) because Schwab's Firefox profile + 2FA prompts can't
# tolerate concurrent invocations. `vnc-login` forwards a 5900-6000
# host port so the operator can drive the live browser.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=schwab-web
ENV_PREFIX=SCHWAB_WEB
ENV_VARS=(SCHWAB_LOGIN_ID SCHWAB_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount during iteration
HAS_SAFETY=1        # refuse to evict a live MFA/VNC session
HAS_VNC=1           # forward a free 5900-6000 port for vnc-login

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    cat <<EOF
schwab-web — host wrapper

Subcommands:
  build                 Build the Docker image (\`docker build\`).
  download [args...]    One-shot CLI-MFA login + scrape. Pre-fills
                        from SCHWAB_LOGIN_ID / SCHWAB_PASSWORD,
                        auto-submits, prompts on stdin for the 2FA
                        code, runs the statements + tx-history
                        download, exits. Default range: 3 months
                        (override with --range; --range Last10Years
                        for a full backfill). Stdin must be a TTY.
  load [args...]        Parse bronze into the silver SQLite DB.
  vnc-login [args...]   Fallback to a VNC-driven login + scrape
                        when the CLI-MFA selectors drift or a
                        non-code challenge is required. Starts
                        x11vnc on 127.0.0.1:5900; tunnel + connect
                        from your local VNC client.
  sh|bash               Open an interactive shell in the container.
  help                  Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  SCHWAB_WEB_SECRETS_DIR=/path/to/secrets
  SCHWAB_WEB_DATA_DIR=/path/to/data
  SCHWAB_WEB_DEBUG_DIR=/path/to/debug

Credentials:
  The Login ID is read from \$SCHWAB_LOGIN_ID inside the container;
  the password from \$SCHWAB_PASSWORD (or prompted interactively
  when not set). The login script sources /secrets/schwab-web.env
  automatically (= \$HOME/.secrets/schwab-web.env on the host).

  Use SINGLE QUOTES around values containing \$, \!, backtick, or
  other shell metacharacters. Double quotes would let the host
  shell do \$-expansion when sourcing the file, which silently
  mangles the password before it reaches the container:
    SCHWAB_LOGIN_ID='your-login-id'
    SCHWAB_PASSWORD='your-password-with-\$pecial-chars'
  chmod 600 the file. Password may also be left out and supplied
  interactively at \`login\` time.
EOF
    exit 0
fi

wrapper_main "$@"
