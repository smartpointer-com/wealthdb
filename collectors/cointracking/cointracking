#!/bin/bash
# Host-side wrapper around `docker run` for the cointracking container.
# Mounts ~/.secrets/ (RW; persistent Firefox profile + env file), the
# bronze tree (RW), and a /debug dir for explore-phase artefacts.
# Lives in single-writer mode because cointracking's session cookie
# + 2FA prompts can't tolerate concurrent invocations.
#
# `explore` forwards a free 5900-6000 host port so the live
# Camoufox session can be driven over VNC; login + download + load
# all run headlessly (vanilla Playwright Firefox).
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=cointracking
ENV_PREFIX=COINTRACKING
# BINANCE_API_KEY is optional — it raises the Binance rate limit for the
# default price fill on `load`; forwarded so a host-exported key reaches
# the container (it also works via /secrets/cointracking.env).
# COINTRACKING_TIMEZONES names the timezone each portfolio's CoinTracking
# account is set to; `load` reads the trade export's dates in it.
ENV_VARS=(COINTRACKING_USERNAME COINTRACKING_PASSWORD BINANCE_API_KEY
          COINTRACKING_TIMEZONES)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount while iterating on explore.py
HAS_SAFETY=1        # refuse to evict a live VNC handoff
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore)   # replaces the default {vnc-login} — no vnc-login verb here
SILVER_SUBCOMMANDS=(load fetch-prices)  # replaces the default {load} — fetch-prices
                                        # backfills prices straight into silver

HERE="$(cd "$(dirname "$0")" && pwd)"

# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
# The deployment's settings, such as COINTRACKING_TIMEZONES, which
# `docker run -e` forwards; the file can also set the per-prefix knobs
# (COINTRACKING_DATA_DIR etc.).
wrapper_source_cfg COINTRACKING "${XDG_CONFIG_HOME:-$HOME/.config}/cointracking.cfg"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
cointracking — host wrapper

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Mint a long-lived session via headless Playwright
                      Firefox. Prompts for the 6-digit TOTP code on
                      stdin and ticks "Don't ask again" so subsequent
                      runs skip the 2FA push for years. --check
                      probes the existing session without firing 2FA.
  download [args...]  Fetch fresh bronze for every linked portfolio:
                      13-column trade history CSV + per-wallet balance
                      CSV via the SPA Export blob. Writes a UTC-
                      timestamped subdir + run.json manifest under the
                      data dir ($HOST_DATA); each CSV export is zstd-
                      compressed in place as it lands (.csv.zst).
                      --dry-run skips the export-button clicks for a
                      navigation-only smoke test.
  load [args...]      Ingest bronze snapshots into the DuckDB silver:
                      replaces \`transactions\`, runs the aggregate-
                      then-window holdings replay, incrementally
                      upserts \`positions_daily\` from the first
                      deviation day onwards, populates
                      \`portfolio_prices\` from overview.csv,
                      reconciles final balances vs the balance CSV.
                      Reads each trade's Date in the portfolio's
                      CoinTracking timezone (see Settings) and
                      stores it in UTC.
                      Pass --replay-only / --force for diagnostics.
                      The price fill (missing USDT-denominated prices
                      from Binance) runs by default at the end;
                      --no-fetch-prices skips it.
  fetch-prices [args] USDT-denominated price backfill from Binance
                      public spot into \`coin_prices\`. --missing
                      fills (held, unpriced) gaps (same as the
                      default \`load\` price fill); no flag re-fetches
                      the full held range (corruption recovery).
                      The latest priced day is always re-fetched to
                      upgrade the previous run's intraday snapshot
                      to a close price. Stablecoins (USDT, USDC,
                      DAI, …) emit synthetic 1.0 USD prices.
                      Optional BINANCE_API_KEY env raises the
                      rate-limit ceiling.
  prune [args...]     Reclaim bronze disk: delete whole non-complete
                      dumps (a crashed / in-progress walk) from the
                      data dir (\$HOST_DATA), and strip screenshots/
                      (the download --debug captures) from complete
                      dumps, whose load inputs are untouched. Runs
                      host-side (no image deps). --dry-run prints the
                      plan; --min-age-hours N (default 1) protects a
                      walk still in flight.
  recompress [args..] One-time backlog sweep: replace plain
                      cu_<id>/*.csv inside complete dumps with
                      sha256-verified .csv.zst twins — the form
                      download writes. Runs in-container (needs
                      the zstd codec; the single-writer guard keeps it
                      from racing a live download). Manual only, never
                      scheduled; review --dry-run first, then verify
                      with \`load --force\`.
  explore [args...]   Re-discovery harness for when cointracking
                      changes a selector. Launches Camoufox in the
                      container's Xvfb display and exposes a VNC port
                      for driving the live browser interactively;
                      records HAR + trace + click log + saved blobs
                      under /debug for analysis. --fresh wipes the
                      profile so the next login forces 2FA.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  COINTRACKING_SECRETS_DIR=/path/to/secrets
  COINTRACKING_DATA_DIR=/path/to/data
  COINTRACKING_DEBUG_DIR=/path/to/debug

Settings:
  $COINTRACKING_CFG is sourced as bash when it exists
  (override the path with COINTRACKING_CFG). Its COINTRACKING_TIMEZONES
  names the timezone each portfolio's CoinTracking account is set to,
  as cu_<id>=<zone> items separated by spaces:
    COINTRACKING_TIMEZONES="cu_1001=Europe/Zurich cu_1002=America/New_York"
  \`load\` reads a portfolio it does not name as UTC.

Credentials:
  COINTRACKING_USERNAME / COINTRACKING_PASSWORD are read from
  /secrets/cointracking.env inside the container
  (= \$HOME/.secrets/cointracking.env on the host). chmod 0600.
  The 2FA code is prompted on stdin during \`login\`; the device-trust
  cookie that lands in /secrets/cointracking-profile/ keeps future
  logins from firing a 2FA push.
EOF
    exit 0
fi

# `prune [args...]` runs host-side (like fidelity-web), not in the
# container: a pure file walk needs no image deps, and running host-side
# bypasses the single-writer safety guard so prune can reclaim disk while
# a download container is mid-flight (prune's own --min-age guard protects
# an in-flight dump). --bronze-dir is passed first so an explicit flag in
# [args...] overrides it (argparse last-wins); the container entrypoint
# keeps a `prune)` arm too, for a direct `docker run`.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
