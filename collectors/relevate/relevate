#!/bin/bash
# Host-side wrapper around `docker run` for the relevate container.
# Mounts ~/.secrets/ (RW; env file in, cookie jar out), the bronze
# data dir (RW), and a separate /debug dir for opt-in scratch logs.
# Sources an optional XDG-style config file at ~/.config/relevate.cfg
# (overrides paths without env vars) and the credentials env file
# (so RELEVATE_LOGIN / RELEVATE_PASSWORD reach the container). The
# common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=relevate
ENV_PREFIX=RELEVATE
ENV_VARS=(RELEVATE_LOGIN RELEVATE_PASSWORD)
HAS_DEBUG=1
HAS_SAFETY=1

HERE="$(cd "$(dirname "$0")" && pwd)"

# Optional XDG-style config file, sourced BEFORE wrapper_init so it
# can override the per-prefix env knobs (RELEVATE_SECRETS_DIR etc.).
# Plain bash, key=value style. Absent file is fine.
RELEVATE_CFG="${RELEVATE_CFG:-$HOME/.config/relevate.cfg}"
if [[ -f "$RELEVATE_CFG" ]]; then
    # shellcheck disable=SC1090
    source "$RELEVATE_CFG"
fi

# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    cat <<EOF
relevate — host wrapper

Subcommands:
  build                 Build the Docker image (\`docker build\`).
  login [args...]       Mint or refresh the Airlock session
                        cookies. Prompts on stdin for the mTAN
                        code sent to your phone. Pass --check to
                        probe the existing session without
                        triggering a new mTAN.
  download [args...]    Bronze dump against /middlelayer/v2/.
                        Pre-requisite: a session minted by
                        \`login\` in /secrets/relevate-state.json.
                        Use --dry-run to enumerate without
                        per-portfolio / per-document fetches; use
                        --mode + --limit-* for iteration-cheap
                        reruns.
  load [args...]        Parse bronze into silver SQLite. Idempotent:
                        skips dumps already loaded, and skips a dump
                        the walk never finished (run.json status
                        in-progress / dry-run).
  prune [args...]       Delete non-complete dumps (crashed walks +
                        --dry-run shells) from the bronze tree. No
                        debug artefacts to reclaim (REST-only). Use
                        --dry-run to print the plan first;
                        --min-age-hours (default 1) guards a download
                        still in flight.
  sh|bash               Open an interactive shell in the container.
  help                  Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env (or in \$HOME/.config/relevate.cfg):
  RELEVATE_SECRETS_DIR=/path/to/secrets
  RELEVATE_DATA_DIR=/path/to/data
  RELEVATE_DEBUG_DIR=/path/to/debug

Credentials:
  The Login is read from \$RELEVATE_LOGIN inside the container; the
  password from \$RELEVATE_PASSWORD. Both are sourced from
  /secrets/relevate.env (= \$HOME/.secrets/relevate.env on the host)
  before \`docker run\`.

  Use SINGLE QUOTES around values containing \$, \!, backtick, or
  other shell metacharacters. Double quotes would let the host
  shell do \$-expansion when sourcing the file, which silently
  mangles the password before it reaches the container:
    export RELEVATE_LOGIN='your-login-or-OASI-number'
    export RELEVATE_PASSWORD='your-password-with-\$pecial-chars'
  chmod 600 the file.
EOF
    exit 0
fi

# Source the credentials env file (RELEVATE_LOGIN / RELEVATE_PASSWORD)
# if present so the subsequent docker-run can forward them. Absence is
# fine for help / sh / build paths.
RELEVATE_ENV_FILE="${RELEVATE_ENV_FILE:-$HOST_SECRETS/relevate.env}"
if [[ -f "$RELEVATE_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$RELEVATE_ENV_FILE"
fi

# `prune [args...]` runs host-side (like fidelity-web), not in the
# container: a pure file walk needs no image deps, and running host-side
# bypasses the single-writer safety guard so prune can reclaim disk while
# a download container is mid-flight (prune's own --min-age guard protects
# an in-flight dump). --bronze-dir is passed first so an explicit flag in
# [args...] overrides it (argparse last-wins); the container entrypoint
# keeps a `prune)` arm too, for a direct `docker run`.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
