#!/bin/bash
# Host-side wrapper around `docker run` for the relevate-dump
# container. Mounts ~/.secrets/ (RW; the container reads the env
# file and writes the persistent cookie jar) and the bronze data
# directory (RW), and forwards arguments to the container's
# entrypoint.

set -euo pipefail

IMAGE="${RELEVATE_IMAGE:-relevate-dump:latest}"

# Fixed container name. Image-hash drift (e.g. after a rebuild)
# would otherwise hide running containers from `docker ps
# --filter ancestor`; with a fixed name, `docker rm -f
# relevate-dump` is a reliable kill-switch regardless of which
# image revision a container was started against. Single-name
# across subcommands also enforces "one relevate-dump container
# at a time".
CONTAINER_NAME="${RELEVATE_CONTAINER:-relevate-dump}"

HERE="$(cd "$(dirname "$0")" && pwd)"

# Optional XDG-style config file. Sourced before mount-point
# defaults so the user can override paths there instead of in env
# vars. The file is plain bash (key=value lines). Absent file is
# fine.
RELEVATE_CFG="${RELEVATE_CFG:-$HOME/.config/relevate-dump.cfg}"
if [[ -f "$RELEVATE_CFG" ]]; then
    # shellcheck disable=SC1090
    source "$RELEVATE_CFG"
fi

# Mount points on the host. Override via env (or via the config
# file above) if your layout differs.
HOST_SECRETS="${RELEVATE_SECRETS_DIR:-$HOME/.secrets}"
HOST_DATA="${RELEVATE_DATA_DIR:-$HOME/wealthdb/relevate}"
# A separate writable dir for opt-in debug artefacts (scratch
# logs, trace bundles). Kept OUT of HOST_DATA so the bronze +
# silver tree stays clean.
HOST_DEBUG="${RELEVATE_DEBUG_DIR:-$HOME/.cache/relevate-debug}"

usage() {
    cat <<EOF
relevate-dump — host wrapper

Subcommands:
  build                 Build the Docker image (\`docker build\`).
  login [args...]       Mint or refresh the Airlock session
                        cookies. Prompts on stdin for the mTAN
                        code sent to your phone. Pass --check to
                        probe the existing session without
                        triggering a new mTAN.
  download [args...]    Bronze dump against /middlelayer/v2/.
                        Pre-requisite: a session minted by
                        \`login\` in /secrets/relevate-state.json.
                        Use --dry-run to enumerate without
                        per-portfolio / per-document fetches; use
                        --mode + --limit-* for iteration-cheap
                        reruns.
  load [args...]        Parse bronze into silver SQLite (NOT YET
                        IMPLEMENTED).
  sh|bash               Open an interactive shell in the container.
  help                  Show this message.

Mounted into the container:
  $HOST_SECRETS  ->  /secrets    (env file + cookie jar state file)
  $HOST_DATA     ->  /data       (bronze artefacts + silver DB)
  $HOST_DEBUG    ->  /debug      (opt-in scratch logs / traces)

Override mounts via env (or in \$HOME/.config/relevate-dump.cfg):
  RELEVATE_SECRETS_DIR=/path/to/secrets
  RELEVATE_DATA_DIR=/path/to/data
  RELEVATE_DEBUG_DIR=/path/to/debug

Credentials:
  The Login is read from \$RELEVATE_LOGIN inside the container; the
  password from \$RELEVATE_PASSWORD. Both are sourced from
  /secrets/relevate.env (= \$HOME/.secrets/relevate.env on the host)
  before \`docker run\`.

  Use SINGLE QUOTES around values containing \$, \!, backtick, or
  other shell metacharacters. Double quotes would let the host
  shell do \$-expansion when sourcing the file, which silently
  mangles the password before it reaches the container:
    export RELEVATE_LOGIN='your-login-or-OASI-number'
    export RELEVATE_PASSWORD='your-password-with-\$pecial-chars'
  chmod 600 the file.
EOF
}

# ./relevate-dump build [extra docker build flags]
if [[ "${1:-}" == "build" ]]; then
    shift
    exec docker build -t "$IMAGE" "$@" "$HERE"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    usage
    exit 0
fi

# Ensure mount points exist on the host before we mount them.
# Docker will silently create them as root-owned directories if
# we don't.
mkdir -p "$HOST_DATA"
mkdir -p "$HOST_DEBUG"
if [[ ! -d "$HOST_SECRETS" ]]; then
    echo "relevate-dump: secrets dir does not exist: $HOST_SECRETS" >&2
    echo "Create it with: mkdir -p $HOST_SECRETS && chmod 700 $HOST_SECRETS" >&2
    exit 1
fi

# Source the env file (RELEVATE_LOGIN / RELEVATE_PASSWORD) if it
# exists. The file is plain bash — convention is `export
# KEY='value'` with single quotes to keep shell metachars literal.
# `source`-ing pulls the values into this shell so the subsequent
# `docker run -e RELEVATE_LOGIN -e RELEVATE_PASSWORD` forwards them
# into the container. The file is optional; absence is fine (e.g.
# for `./relevate-dump help`, `./relevate-dump sh`).
RELEVATE_ENV_FILE="${RELEVATE_ENV_FILE:-$HOST_SECRETS/relevate.env}"
if [[ -f "$RELEVATE_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$RELEVATE_ENV_FILE"
fi

# Allocate a TTY only when stdin AND stdout are TTYs. This makes
# the wrapper safe to pipe (e.g. for log capture) while still
# giving interactive prompts when run from a terminal. The
# `${arr[@]+...}` idiom expands to nothing when the array is
# empty, which keeps bash 3.2 (Apple's /bin/bash) happy under
# `set -u`.
TTY_ARGS=()
if [[ -t 0 && -t 1 ]]; then
    TTY_ARGS=(-it)
fi

# Safety guard: refuse to clobber a live container.
#
# If a `login` session is mid-mTAN-prompt and the user runs
# another wrapper invocation (`./relevate-dump sh`, etc.), a
# naive `docker rm -f $CONTAINER_NAME` would kill the live
# session and burn the 2FA push in flight. Refuse instead; let
# the user decide. Override with RELEVATE_FORCE_REPLACE=1 only
# when the running container is known-stuck.
if docker ps --filter "name=^${CONTAINER_NAME}$" --filter "status=running" -q | grep -q .; then
    if [[ "${RELEVATE_FORCE_REPLACE:-0}" != "1" ]]; then
        echo "relevate-dump: a container named '$CONTAINER_NAME' is already running." >&2
        echo "  Refusing to evict it — that would kill any live Relevate session." >&2
        echo "  Options:" >&2
        echo "    * Use a different name:    RELEVATE_CONTAINER=otherthing $0 $*" >&2
        echo "    * Enter the existing one:  docker exec -it $CONTAINER_NAME sh" >&2
        echo "    * Force replace:           RELEVATE_FORCE_REPLACE=1 $0 $*" >&2
        exit 2
    fi
    echo "relevate-dump: RELEVATE_FORCE_REPLACE=1 — evicting live container" >&2
fi

# Evict any prior (stopped) container with this name (best-effort
# — no-op when the name isn't in use). Past this point we've
# already refused to clobber a RUNNING container; this only
# affects exited-but-not-cleaned-up state.
docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

exec docker run --rm --name "$CONTAINER_NAME" \
    ${TTY_ARGS[@]+"${TTY_ARGS[@]}"} \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e RELEVATE_LOGIN \
    -e RELEVATE_PASSWORD \
    -v "$HOST_SECRETS:/secrets" \
    -v "$HOST_DATA:/data" \
    -v "$HOST_DEBUG:/debug" \
    "$IMAGE" "$@"
