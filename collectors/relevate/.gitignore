# Python, test, editor and OS artefacts are ignored by the root
# .gitignore. This file adds what this collector must never commit.

# Never commit credentials, env files, or downloaded portfolio data
*.pem
*.key
relevate_state*.json
token.json
tokens.json
.env
.envrc
relevate.env
data/
downloads/

# Silver databases — contain parsed account data
*.db
*.db-journal
*.db-wal
*.db-shm
