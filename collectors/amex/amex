#!/bin/bash
# Host-side wrapper around `docker run` for the amex container. Mounts
# ~/.secrets/ (RW; persistent Camoufox profile + env file), the bronze
# tree (RW), and a /debug dir for the diagnostics explore and --debug
# runs write. Single-writer:
# the session cookie + 2FA prompts can't tolerate concurrent invocations,
# and the safety guard refuses to evict a container hosting a live VNC
# session.
#
# The sign-in must run in the browser (Akamai — DESIGN.md §A), and
# `download` is the only verb that performs one: `login` folded into it (§L)
# because Amex's sign-in budget is small enough that a captcha fires at
# roughly seven in twenty minutes (§K), and a separate `login` doubled the
# cost of every routine run for nothing. `download` answers a passcode from
# the terminal when it has a TTY and registers the device while it is there;
# `vnc-login` is the same walk behind a hand-driven sign-in, the only way to
# answer a captcha. `load` and `prune` are pure Python. `explore` and
# `vnc-login` forward a free 5900-6000 host port for the VNC handoff.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=amex
ENV_PREFIX=AMEX
ENV_VARS=(AMEX_USERNAME AMEX_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount during iteration
HAS_SAFETY=1        # refuse to evict a live container mid-2FA / mid-VNC
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore vnc-login)   # the browser-over-VNC verbs

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
amex — host wrapper

Read-only collector for the American Express card relationship (credit and
charge cards). \`download\` is a one-shot sign-in + REST fetch of each
card's activity, exports and statement PDFs; \`load\` ingests that bronze
into the SQLite silver. See DESIGN.md for the mapped flows.

Subcommands:
  build               Build the Docker image (\`docker build\`).
  download [args...]  One-shot sign-in + REST fetch of the card accounts
                      (roster, activity ledger, exports, statement PDFs)
                      into a UTC-stamped bronze run dir. A trusted device
                      needs no passcode; a challenge is answered from the
                      TERMINAL when there is one — registering the device,
                      so the next run is unattended — and is a loud failure
                      otherwise (--cli-mfa / --no-cli-mfa force either).
                      --lookback bounds the window; --format picks export
                      formats; --no-documents skips statements; --dry-run
                      walks without exporting.
  vnc-login [args...] Fallback for download: exposes VNC for a by-hand
                      sign-in — the only way to answer a captcha, and the
                      way to register a device with no terminal. Add
                      --fresh to force the untrusted-device flow (moves the
                      stored device trust aside first).
  login [args...]     Folds into download (the sign-in budget is too small
                      to spend one on a separate verb, §L); a bare one is a
                      host-side no-op. \`login --check\` reports whether
                      this device is registered, read from the profile's
                      device-trust cookie — no sign-in, no network.
  load [args...]      Ingest bronze into the SQLite silver (accounts,
                      transactions, statement balances, documents).
                      --force rebuilds from all bronze.
  explore [args...]   Discovery harness: Camoufox over VNC + HAR / network
                      log / click log / DOM snapshots under /debug.
  prune [args...]     Delete non-complete dumps from the bronze tree (runs
                      host-side). --dry-run prints the plan.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  AMEX_SECRETS_DIR=/path/to/secrets
  AMEX_DATA_DIR=/path/to/data
  AMEX_DEBUG_DIR=/path/to/debug

Credentials:
  AMEX_USERNAME / AMEX_PASSWORD are read from /secrets/amex.env inside the
  container (= \$HOME/.secrets/amex.env on the host). chmod 0600.
  A one-time passcode is driven from the terminal (\`download\`, when it
  has one) or by hand over VNC (\`vnc-login\`). During \`explore\` the
  harness only pre-fills the form — Sign In and the challenge are always
  driven by hand.
EOF
    exit 0
fi

# `login` folds into `download` (DESIGN.md §L), so a bare one is a host-side
# no-op: exit 0 without starting a container at all. That keeps an
# orchestrator's login -> download -> load from tripping, and — since the
# orchestrator runs the pair for every source — saves a container start per
# source per refresh. `login --check` is a real verb and passes through; it
# reads the profile's device-trust cookie and touches no network.
if [[ "${1:-}" == "login" ]]; then
    HAS_CHECK=no
    for arg in "$@"; do
        if [[ "$arg" == "--check" ]]; then
            HAS_CHECK=yes
        fi
    done
    if [[ "$HAS_CHECK" == "no" ]]; then
        echo "amex: 'login' folds into 'download' — the sign-in budget is" \
             "too small to spend one on a separate verb (DESIGN.md §L)." >&2
        echo "  Run 'download', or 'login --check' to report whether this" \
             "device is registered." >&2
        exit 0
    fi
fi

# prune is a pure file walk (collectorkit.prune + stdlib) — no browser, no
# container. Run it host-side like the other collectors so it bypasses the
# single-writer safety guard and can reclaim disk while a download is
# mid-flight (its own --min-age guard protects an in-flight dump). With
# HAS_DEBUG=1 the wrapper also passes --debug-dir so the /debug cache is
# reclaimed.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
