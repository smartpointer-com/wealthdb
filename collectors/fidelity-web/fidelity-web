#!/bin/bash
# Host-side wrapper around `docker run` for the fidelity-web container.
# Mounts ~/.secrets/ (RW; profile dir holding the "Trust this browser"
# cookie + env file), the bronze tree (RW), and a /debug dir for
# opt-in screenshots / traces. Lives in single-writer mode (named
# container, refuse-to-clobber-running safety guard) because Fidelity's
# Camoufox profile and 2FA prompts can't tolerate concurrent
# invocations.
#
# HYBRID collector (see .host-venv): the Camoufox `download` /
# `vnc-login` run in the Docker image; the file-only verbs run on the
# host venv (`make build-fidelity-web` builds it from requirements.txt
# with collectorkit editable-installed):
#   * `load` runs the silver loader host-side via the venv python
#     (host_python) — the loader decompresses zstd bronze in Python
#     (SQLite silver, no native .zst streaming) so the venv carries
#     zstandard + pdfplumber. Running host-side saves the docker-spin
#     overhead and lets the loader run while a `download` container is
#     mid-flight.
#   * `prune` / `recompress` are the same: pure file walks, run under
#     the venv, bypassing the single-writer safety guard (their own age
#     guard protects an in-flight dump). `prune` walks the bronze tree
#     plus the /debug cache, which nothing else reclaims.
#   * `vnc-login` forwards a free 5900-6000 host port for the
#     human-driven first-time profile-seed.
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh;
# host_python comes from shared/wrappers/host-lib.sh.

set -euo pipefail

NAME=fidelity-web
ENV_PREFIX=FIDELITY_WEB
ENV_VARS=(FIDELITY_WEB_USERNAME FIDELITY_WEB_PASSWORD FIDELITY_USERNAME FIDELITY_PASSWORD)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # /app live-mount during iteration
HAS_SAFETY=1        # refuse to evict a live MFA / VNC handoff
HAS_VNC=1           # forward a free 5900-6000 port for vnc-login

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
# host-lib.sh provides host_python (the collector's .venv python, built
# by `make build-fidelity-web`) for the file-only host-side verbs
# (load / prune / recompress). It only defines functions; no globals
# clash with wrapper-lib.sh.
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
fidelity-web — host wrapper

Subcommands:
  build                 Build the Docker image (\`docker build\`).
  download [args...]    One-shot: log in (prompts on stdin for the
                        Fidelity 2FA code if MFA fires; auto-skips
                        when the device-trust cookie is valid), run
                        the requested walk phases, log out, exit.
                        Stdin must be a TTY when MFA is expected.
                        Pass --check to validate the session without
                        scraping.
  load [args...]        Parse bronze into the silver SQLite DB.
                        Runs host-side on the venv python (decompresses
                        zstd bronze in Python; no Docker spawn).
  prune [args...]       Delete debug artefacts (<run>/screenshots/,
                        written only by download --debug/--explore)
                        and non-complete dumps from the bronze tree,
                        plus aged-out entries of the /debug cache.
                        Runs host-side. --dry-run prints the plan
                        without deleting anything.
  recompress [args...]  One-time backlog sweep: replace plain
                        HTML/CSV bronze (balances/performance HTML,
                        positions/activity/statement CSV) inside
                        complete dumps with sha256-verified .zst
                        twins — the form download now writes. Runs
                        host-side. Manual only, never scheduled;
                        review --dry-run first, verify with
                        \`load --force\`.
  vnc-login [args...]   First-time profile-dir seed: pre-fills
                        credentials, hands off to a VNC client for
                        the human-driven click + 2FA, then runs the
                        walk (or just exits with --mode none).
                        Starts x11vnc on the first free port in
                        127.0.0.1:5900-6000 (printed at handoff);
                        tunnel + connect from your local VNC client.
  sh|bash               Open an interactive shell in the container.
  help                  Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  FIDELITY_WEB_SECRETS_DIR=/path/to/secrets
  FIDELITY_WEB_DATA_DIR=/path/to/data
  FIDELITY_WEB_DEBUG_DIR=/path/to/debug

Credentials:
  Read from \$FIDELITY_WEB_USERNAME / \$FIDELITY_WEB_PASSWORD inside
  the container (the unprefixed \$FIDELITY_USERNAME / \$FIDELITY_PASSWORD
  still work as a legacy fallback). The script sources
  /secrets/fidelity-web.env automatically
  (= \$HOME/.secrets/fidelity-web.env on the host).

  Use SINGLE QUOTES around values containing \$, \!, backtick, or
  other shell metacharacters. Double quotes would let the host
  shell do \$-expansion when sourcing the file, which silently
  mangles the password before it reaches the container:
    FIDELITY_WEB_USERNAME='your-username'
    FIDELITY_WEB_PASSWORD='your-password-with-\$pecial-chars'
  chmod 600 the file.
EOF
    exit 0
fi

# `./fidelity-web login` → clean host-side no-op (exit 0), never a container
# spin. The Fidelity session lives only for the browser's lifetime, so a
# login-and-exit persists nothing. Trapping it here keeps an orchestrator's
# login → download → load from tripping (and stops `login` from reaching the
# container's util-linux /bin/login). Use `download` (login is folded in) or
# `vnc-login` for the first-time / re-auth VNC-assisted profile seed.
if [[ "${1:-}" == "login" ]]; then
    echo "fidelity-web: 'login' folds into 'download' — nothing to persist." >&2
    echo "  The Fidelity session is browser-lifetime only. Use instead:" >&2
    echo "    vnc-login   first-time / re-auth via VNC-assisted MFA" >&2
    echo "    download    one-shot login -> walk (login is folded in)" >&2
    exit 0
fi

# The file-only verbs (load / prune / recompress) run host-side on the
# collector's .venv python (via host_python): pure file walks + SQLite /
# zstd work that needs no Camoufox / Playwright / container, and running
# host-side bypasses the single-writer safety guard so it can run while a
# `download` container is mid-flight (an in-flight dump is protected by
# prune's own age guard). Each resolves the uniform directory-override
# flags through the shared host helper — `host_resolve_dirs <verb> "$@"`
# consumes --data-dir / --secrets-dir / --silver-db (both `--flag VALUE` and
# `--flag=VALUE`), sets DATA_DIR (the bronze tree), SILVER_DB
# (<data>/fidelity-web.db by default, or ${FIDELITY_WEB_SILVER_DB}) and
# DEBUG_DIR (the /debug mount source), and leaves the rest in FORWARD_ARGS. It takes the verb so --silver-db is
# rejected on prune / recompress, which never read it — so these verbs honour the dir flags
# like every other, and --help / the real flags reach the inner .py's
# argparse rather than a hand-rolled help that hides --force et al.

# `./fidelity-web load [args...]` — parse bronze → silver SQLite.
if [[ "${1:-}" == "load" ]]; then
    shift
    host_resolve_dirs load "$@"
    exec "$(host_python)" "$HERE/load.py" \
        --silver-db "$SILVER_DB" \
        --bronze-dir "$DATA_DIR" \
        ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
fi

# `./fidelity-web prune [args...]` — reclaim disk (host-side walk): the
# bronze tree, plus the /debug cache the container's --screenshot-dir /
# --trace write to. host_resolve_dirs resolves DEBUG_DIR exactly as
# wrapper-lib resolves HOST_DEBUG, so both halves name the same dir.
if [[ "${1:-}" == "prune" ]]; then
    shift
    host_resolve_dirs prune "$@"
    exec "$(host_python)" "$HERE/prune.py" --bronze-dir "$DATA_DIR" \
        --debug-dir "$DEBUG_DIR" \
        ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
fi

# `./fidelity-web recompress [args...]` — one-time backlog sweep converting
# pre-compression HTML/CSV bronze to the .zst form download now writes
# (verify-then-unlink per file, under prune's completeness envelope).
# Manual only — never schedule; review --dry-run first.
if [[ "${1:-}" == "recompress" ]]; then
    shift
    host_resolve_dirs recompress "$@"
    exec "$(host_python)" "$HERE/recompress.py" --bronze-dir "$DATA_DIR" \
        ${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}
fi

wrapper_main "$@"
