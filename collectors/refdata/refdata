#!/usr/bin/env bash
# refdata — host wrapper for the wealthdb "refdata" collector.
#
# Host-venv collector (no Docker): reads public reference data, what each
# fund holds and states about itself and what each security is and
# reports, for the funds and securities the engine names in its wanted
# list. No provider signs in to an account. One provider takes a
# credential. finra reads FINRA_CLIENT_ID and FINRA_CLIENT_SECRET.
# download and login, the verbs that ask FINRA, source both from
# <secrets-dir>/finra.env; $FINRA_ENV_FILE names another path.
# `--client-id ID` gives the id directly. Subcommands:
#   login               No-op: there is no session. `login --check` asks
#                       every enabled provider for its cheapest answer.
#   download [args...]  Ask the engine for the wanted list (or read
#                       --wanted FILE) and fetch what is missing into bronze.
#                       --backfill also fetches past dates; --dry-run plans
#                       only; --provider / --ref / --limit narrow a run.
#   load [args...]      Parse bronze into the silver SQLite DB.
#   prune [args...]     Delete non-complete bronze run dirs and debug
#                       traces; complete dumps are kept. --dry-run previews.
#   compact [args...]   Give the complete runs' files the form download
#                       stores them in; nothing a parser reads goes. Manual
#                       only, never scheduled. --dry-run previews.
#
# Uniform directory overrides (CLI flag > ${PREFIX}_* env > WEALTHDB_* env
# > default), accepted on any subcommand:
#   --secrets-dir DIR   env file dir            (default ~/.secrets)
#   --data-dir    DIR   bronze dumps and inbox  (default $XDG_DATA_HOME/wealthdb/refdata)
#   --silver-db   PATH  silver DB path          (default <data-dir>/refdata.db)
# Settings live in $XDG_CONFIG_HOME/refdata.cfg (README.md). The engine
# that prints the wanted list: README.md, Settings (`engine`).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAME=refdata
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/host-lib.sh"

host_begin login download load prune compact -- "$@"
host_source_env_file
# FINRA's credential reaches only the verbs that ask FINRA. download
# keeps it from the engine it asks for the wanted list (wanted.py).
case "$VERB" in
    login|download) host_source_env_file finra ;;
esac

case "$VERB" in
    login)
        # No provider mints a session. `--check` asks each enabled
        # provider for its cheapest answer instead.
        host_login_probe download.py --bronze-dir "$DATA_DIR" <<'EOF'
refdata: no-op. No provider has a session to mint.
To probe each enabled provider, run `./refdata login --check`.
EOF
        ;;
    download) host_run download.py --bronze-dir "$DATA_DIR" ;;
    load)     host_run load.py --silver-db "$SILVER_DB" --bronze-dir "$DATA_DIR" ;;
    prune)    host_run prune.py --bronze-dir "$DATA_DIR" ;;
    compact)  host_run compact.py --bronze-dir "$DATA_DIR" ;;
esac
