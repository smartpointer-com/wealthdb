#!/bin/bash
# Host-side wrapper around `docker run` for the swissquote container.
# Mounts ~/.secrets/ (RW for the state-file write) and the bronze
# directory (RW), and forwards all arguments to the container.
# The common docker-run plumbing lives in
# shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=swissquote
ENV_PREFIX=SWISSQUOTE
ENV_VARS=(SWISSQUOTE_USERNAME SWISSQUOTE_PASSWORD)
HAS_DEBUG=1         # /debug mount for login.py --screenshot-dir / --trace
# No live-code /app mount, no safety guard (no long-running interactive
# container), and no VNC subcommand.

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || $# -eq 0 ]]; then
    cat <<EOF
swissquote — host wrapper

Subcommands:
  build               Build the Docker image (\`docker build\`).
  login [args...]     Mint or refresh the session state file.
  download [args...]  Export bronze artefacts from e-banking.
  load [args...]      Parse bronze into the silver SQLite DB.
  prune [args...]     Reclaim bronze disk: delete non-complete dumps
                      (--dry-run previews the plan; --min-age-hours N
                      guards a download still in flight).
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  SWISSQUOTE_SECRETS_DIR=/path/to/secrets
  SWISSQUOTE_DATA_DIR=/path/to/data

Pass-through env (set on host, available inside container):
  SWISSQUOTE_USERNAME
  SWISSQUOTE_PASSWORD
EOF
    exit 0
fi

# `prune [args...]` runs host-side (like fidelity-web), not in the
# container: a pure file walk needs no image deps, and running host-side
# bypasses the single-writer safety guard so prune can reclaim disk while
# a download container is mid-flight (prune's own --min-age guard protects
# an in-flight dump). --bronze-dir is passed first so an explicit flag in
# [args...] overrides it (argparse last-wins); the container entrypoint
# keeps a `prune)` arm too, for a direct `docker run`.
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
