#!/bin/sh
# wealthdb — the engine's launcher. A tree runs one kind of engine, the
# one ./configure recorded (shared/wrappers/engine-mode.sh):
#   container  `docker run wealthdb:<tag>`, the tag
#              shared/wrappers/image-tag.sh resolves (latest by default).
#              See docs/DESIGN.md §12.2 for the mount geometry.
#   native     the program wealthdb-engine beside this script, built by
#              `wealthdb build`.
set -eu

# The command this run was started by, as an absolute path: the name on
# PATH, which stays in place when a newer version is installed. A
# server's LaunchAgent runs it (shared/wrappers/service-lib.sh).
case "$0" in
    /*)  entry="$0" ;;
    */*) entry="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" ;;
    *)   entry="$(command -v "$0" 2>/dev/null || printf '%s' "$0")" ;;
esac
export WEALTHDB_ENTRY="${WEALTHDB_ENTRY:-$entry}"

# Resolve $0 through symlinks (macOS has no `readlink -f`) so this
# works when run via the ~/.local/bin/wealthdb symlink `make install` creates
# — same idiom as bin/wealthdb-collect. Without this, `wealthdb web`
# (which locates the repo via $REPO) would break when run bare.
SELF="$0"
while [ -L "$SELF" ]; do
    link="$(readlink "$SELF")"
    case "$link" in
        /*) SELF="$link" ;;
        *)  SELF="$(dirname "$SELF")/$link" ;;
    esac
done
REPO="$(cd "$(dirname "$SELF")" && pwd)"
ROOT="$(cd "$REPO/.." && pwd)"
. "$ROOT/shared/wrappers/image-tag.sh"
. "$ROOT/shared/wrappers/engine-mode.sh"
wealthdb_export_image_tag "$ROOT" || exit 2
IMAGE="wealthdb:$WEALTHDB_IMAGE_TAG"
MODE="$(wealthdb_engine_mode "$ROOT")" || exit 2

# `build`, `web`, `mcp` and `collect` are handled here, not by the
# engine. `build` builds the engine: the image with `docker build`, which
# it skips when the image was built from the same inputs and no extra
# argument is given, or the native program with `go build`. The other
# three are found past the global flags, below.
case "${1:-}" in
    build)
        shift
        # The version stamp (internal/version), read from git here because
        # the build context holds no .git: the release tag only when HEAD
        # sits on one and the engine tree has no uncommitted change, the
        # nearest release tag, and HEAD's hash, marked -dirty when the
        # engine tree has changes. What .dockerignore leaves out of the
        # build context is no change. Outside a git checkout all three
        # stay empty, and the binary never claims a release.
        #
        # An archive git made of a commit states its own version, and is
        # read first: .archive-version then holds that commit's hash and
        # its description, which git wrote in (export-subst,
        # .gitattributes). A git repository around the unpacked archive
        # is another project's, and is not asked. A checkout holds the
        # file as git did not fill it in, which is no hash.
        tag="" base="" commit="" from_archive=0
        archived="$(sed -n 's/^commit: //p' "$REPO/.archive-version" 2>/dev/null || true)"
        case "$archived" in
            *[!0-9a-f]* | '') ;;
            *)
                from_archive=1
                commit="$(printf '%s' "$archived" | cut -c1-7)"
                desc="$(sed -n 's/^describe: //p' "$REPO/.archive-version")"
                case "$desc" in
                    v[0-9]*-[0-9]*-g*) base="${desc%-*-g*}" ;;
                    v[0-9]*) tag="$desc" base="$desc" ;;
                esac
                ;;
        esac
        if [ "$from_archive" = 0 ] && git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
            commit="$(git -C "$REPO" rev-parse --short=7 HEAD)"
            base="$(git -C "$REPO" describe --tags --abbrev=0 --match 'v[0-9]*' HEAD 2>/dev/null || true)"
            # A subshell, so the pathspecs leave the build's arguments alone.
            changes="$(
                set -- .
                if [ -f "$REPO/.dockerignore" ]; then
                    while IFS= read -r line; do
                        case "$line" in (''|'#'*) ;; (*) set -- "$@" ":(exclude,glob)$line" ;; esac
                    done < "$REPO/.dockerignore"
                fi
                git -C "$REPO" status --porcelain --untracked-files=normal -- "$@" 2>/dev/null || true
            )"
            if [ -n "$changes" ]; then
                commit="$commit-dirty"
            else
                tag="$(git -C "$REPO" describe --tags --exact-match --match 'v[0-9]*' HEAD 2>/dev/null || true)"
            fi
        fi
        v=github.com/smartpointer-com/wealthdb/wealthdb/internal/version
        if [ "$MODE" = native ]; then
            # Go's own build cache makes an unchanged build a relink.
            GO="$(wealthdb_tool "$ROOT" GO go)"
            cd "$REPO"
            exec "$GO" build \
                -ldflags "-X $v.Tag=$tag -X $v.Base=$base -X $v.Commit=$commit" \
                -o "$(wealthdb_native_engine "$ROOT")" "$@" ./cmd/wealthdb
        fi
        # The inputs: this tree less what .dockerignore leaves out, the
        # stamp and the base image's id. A hash that fails (no python3 on
        # the host, or a .dockerignore line it cannot follow) leaves the
        # image unlabeled, so it is built every time and never skipped.
        hash="$(wealthdb_inputs_hash --ignore "$REPO/.dockerignore" "$REPO" -- "$tag" "$base" "$commit" "$(wealthdb_from_id "$REPO/Dockerfile")")" || hash=
        if wealthdb_build_unchanged "$IMAGE" "$hash" "$#"; then
            exit 0
        fi
        # --provenance=false: buildx's default attestation would give the
        # image a fresh digest on every build even when fully cached.
        exec docker build --provenance=false \
            ${hash:+--label "wealthdb.inputs=$hash"} \
            --build-arg WEALTHDB_TAG="$tag" \
            --build-arg WEALTHDB_BASE="$base" \
            --build-arg WEALTHDB_COMMIT="$commit" \
            -t "$IMAGE" "$REPO" "$@"
        ;;
esac

# One pass over the global flags (-c PATH, -r, in their -x, --x and
# --x=V forms): a -c path is made absolute in place and names the
# config, and the first argument past them is the subcommand. The
# arguments are rebuilt in order. lead counts the arguments before the
# subcommand, and flag_cfg is 1 when a -c named the config, FLAG_CFG.
sub="" want=0 past=0 lead=0 flag_cfg=0 FLAG_CFG="" n=$#
for a in "$@"; do
    if [ "$past" = 0 ]; then
        if [ "$want" = 1 ]; then
            a="$(wealthdb_abs_path "$a")" FLAG_CFG="$a" want=0 flag_cfg=1
        else
            case "$a" in
                -c|--c|-config|--config) want=1 ;;
                -c=*|--c=*|-config=*|--config=*)
                    FLAG_CFG="$(wealthdb_abs_path "${a#*=}")"
                    a="${a%%=*}=$FLAG_CFG" flag_cfg=1
                    ;;
                -*) ;;
                *) sub="$a" past=1 ;;
            esac
        fi
        [ "$past" = 1 ] || lead=$((lead + 1))
    fi
    set -- "$@" "$a"
done
shift "$n"

# The config file is the -c flag's path, else WEALTHDB_CONFIG, else
# wealthdb.cfg in the XDG config dir ($XDG_CONFIG_HOME, falling back to
# ~/.config). It is mounted at the same path, and the variables are
# forwarded, so the engine's own config resolution lands on the mounted
# file. A relative path is made absolute here, in the flag too, since
# the container's working directory is not the host's.
#
# The data root (the gold DB and every silver DB) follows the config
# (wealthdb_engine_paths). For the default config it is the XDG data dir
# ($XDG_DATA_HOME/wealthdb, falling back to ~/.local/share/wealthdb), or
# anywhere via WEALTHDB_DATA_ROOT, e.g. a shared, ACL-gated dir outside
# $HOME. Any other config is a setup of its own, and its folder is the
# data root. It is mounted at the SAME path inside the container so the
# config's ${WEALTHDB_DATA_ROOT}/... entries resolve identically on both
# sides, and the variable is forwarded so that expansion (and the
# collectors' own wrappers) agree. The host path must be one Docker can
# see (for Colima, listed under `mounts:` in colima.yaml).
wealthdb_engine_paths "$FLAG_CFG"
ENV_CFG=""
if [ -n "${WEALTHDB_CONFIG:-}" ]; then ENV_CFG="$(wealthdb_abs_path "$WEALTHDB_CONFIG")"; fi

# `web`, `mcp`, `collect` and `refresh` run on the host, not in the
# engine: `web` and `mcp` are the web/ and mcp/ components' lifecycle
# scripts, `collect` is the collectors' dispatcher, and `refresh` runs
# every collector of the config, then the loads. Docker is not reachable from
# inside the engine container, so the servers and the collectors are
# orchestrated here. (web/, mcp/ and bin/ are siblings of this inner
# wealthdb/ dir.) The global flags before the subcommand are the
# engine's and are dropped. A -c path reaches the script as
# WEALTHDB_CONFIG, where it reads the config's path.
# A setup of its own also hands the script its data root and the words
# a command it prints starts with (wealthdb_export_setup).
host=
case "$sub" in
    web)     host="$ROOT/web/web" ;;
    mcp)     host="$ROOT/mcp/mcp" ;;
    collect) host="$ROOT/bin/wealthdb-collect" ;;
    refresh) host="$ROOT/bin/wealthdb-refresh" ;;
esac
if [ -n "$host" ]; then
    shift "$((lead + 1))"
    if [ "$flag_cfg" = 1 ]; then export WEALTHDB_CONFIG="$CFG"; fi
    wealthdb_export_setup
    exec "$host" "$@"
fi

mkdir -p "$CFG_DIR" "$DATA_ROOT"

# The config may be a symbolic link, as a dotfile manager makes one.
# CFG_TARGET is the file its links name: `config` writes that file, and
# mounts its folder too, so the link stays a link. A link into a folder
# that does not exist is refused before anything is created.
CFG_TARGET="$CFG" hops=0
while [ -L "$CFG_TARGET" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
        echo "wealthdb: the config $CFG is a link that names itself; nothing is changed" >&2
        exit 2
    fi
    link="$(readlink "$CFG_TARGET")"
    case "$link" in
        /*) CFG_TARGET="$link" ;;
        *)  CFG_TARGET="$(dirname "$CFG_TARGET")/$link" ;;
    esac
done
if [ ! -d "$(dirname "$CFG_TARGET")" ]; then
    echo "wealthdb: the config $CFG is a link to $CFG_TARGET, whose folder does not exist; nothing is changed" >&2
    exit 2
fi
CFG_TARGET_DIR="$(cd "$(dirname "$CFG_TARGET")" && pwd)"

# `config` gets the host's locale, whose region guesses the currency.
locale=
if [ "$sub" = config ]; then
    if [ "$(uname -s)" = Darwin ]; then
        locale="$(defaults read -g AppleLocale 2>/dev/null || true)"
    fi
    locale="${locale:-${LC_ALL:-${LC_MONETARY:-${LANG:-}}}}"
fi

# The native engine reads the same files under the same names, with
# nothing to mount. It is told the paths the container engine is told,
# and its kind, which it holds a database to (claimGoldForEngine).
# `config` gets the locale and a TERM, as in a container (below).
if [ "$MODE" = native ]; then
    wealthdb_require_native_engine wealthdb "$ROOT" || exit 2
    export WEALTHDB_DATA_ROOT="$DATA_ROOT" XDG_CONFIG_HOME="$XDG_CFG" WEALTHDB_ENGINE=native
    if [ -n "$ENV_CFG" ]; then export WEALTHDB_CONFIG="$ENV_CFG"; fi
    if [ "$sub" = config ]; then export WEALTHDB_LOCALE="$locale" TERM="${TERM:-dumb}"; fi
    exec "$(wealthdb_native_engine "$ROOT")" "$@"
fi

# Every subcommand but `config` mounts the config FILE (Docker follows a
# link to its file), made empty when there is none: Docker would make a
# folder in its place. `config` saves by renaming a temporary file over
# the config, which a file mount refuses, so it mounts the config's
# folder instead, and the folder of the file a link names. It creates
# the file itself, so `config validate` on a path with no file leaves
# none. It also gets TERM, so a terminal that cannot do raw mode gets
# the numbered menu.
#
# A folder that is the data root is mounted once, as the data root:
# Docker refuses two mounts of one path, and a setup of its own keeps
# its config in its data root.
CFG_MOUNT="$CFG:$CFG" MOUNTS="$CFG"
if [ "$sub" = config ]; then
    root="$(wealthdb_clean_path "$DATA_ROOT")"
    CFG_MOUNT="$CFG_DIR:$CFG_DIR" MOUNTS="$CFG_DIR"
    if [ "$(wealthdb_clean_path "$CFG_DIR")" = "$root" ]; then CFG_MOUNT=""; fi
    set -- -e WEALTHDB_LOCALE="$locale" -e TERM="${TERM:-dumb}" "$IMAGE" "$@"
    if [ "$CFG_TARGET_DIR" != "$(cd "$CFG_DIR" && pwd)" ]; then
        if [ "$(wealthdb_clean_path "$CFG_TARGET_DIR")" != "$root" ]; then
            set -- -v "$CFG_TARGET_DIR:$CFG_TARGET_DIR" "$@"
        fi
        MOUNTS="$MOUNTS:$CFG_TARGET_DIR"
    fi
else
    [ -f "$CFG" ] || : > "$CFG"
    set -- "$IMAGE" "$@"
fi

# NO_COLOR, when the host sets it, turns the engine's colours off too.
if [ -n "${NO_COLOR+x}" ]; then
    set -- -e NO_COLOR="$NO_COLOR" "$@"
fi

# WEALTHDB_CONFIG goes to the engine as the host set it, made absolute.
# A -c path stays a flag. The engine names a config that is not the
# default one in every command it prints, whichever way it was named.
if [ -n "$ENV_CFG" ]; then
    set -- -e WEALTHDB_CONFIG="$ENV_CFG" "$@"
fi

# The host's system and the folders mounted, so the engine refuses a
# folder that Docker on a Mac does not share with its virtual machine
# (checkSharedMounts): such a mount takes what is saved into the machine
# alone. ':' separates them; a mount path cannot hold one.
set -- -e WEALTHDB_HOST_OS="$(uname -s)" -e WEALTHDB_MOUNTS="$MOUNTS:$DATA_ROOT" "$@"

# The engine's kind, which it holds a database to (claimGoldForEngine).
set -- -e WEALTHDB_ENGINE=container "$@"

# Allocate a TTY only when the host shell has one. `wealthdb config`
# requires this; the other subcommands work either way. Cron / piped
# invocations skip both flags.
TTY=""
[ -t 0 ] && [ -t 1 ] && TTY="-it"

wealthdb_require_image wealthdb "$IMAGE" "Build it with: wealthdb build" || exit 2

# host.docker.internal is this computer, as Docker on a Mac names it
# already: an AI model served here is reached at that name, on Linux
# too.
exec docker run --rm --pull=never $TTY \
    --add-host=host.docker.internal:host-gateway \
    -e HOME="$HOME" \
    -e XDG_CONFIG_HOME="$XDG_CFG" \
    -e WEALTHDB_DATA_ROOT="$DATA_ROOT" \
    -u "$(id -u):$(id -g)" \
    ${CFG_MOUNT:+-v "$CFG_MOUNT"} \
    -v "$DATA_ROOT:$DATA_ROOT" \
    "$@"
