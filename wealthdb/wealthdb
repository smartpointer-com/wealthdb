#!/bin/sh
# wealthdb — host-side wrapper around `docker run wealthdb:latest`.
# See docs/DESIGN.md §12.2 for the mount geometry.
set -eu

# Resolve $0 through symlinks (macOS has no `readlink -f`) so this
# works when run via the ~/bin/wealthdb symlink `make install` creates
# — same idiom as bin/wealthdb-collect. Without this, `wealthdb web`
# (which locates the repo via $REPO) would break when run bare.
SELF="$0"
while [ -L "$SELF" ]; do
    link="$(readlink "$SELF")"
    case "$link" in
        /*) SELF="$link" ;;
        *)  SELF="$(dirname "$SELF")/$link" ;;
    esac
done
REPO="$(cd "$(dirname "$SELF")" && pwd)"
IMAGE="wealthdb:latest"

# `build` and `web` are wrapper-handled host-side, not container
# subcommands: `build` runs `docker build`; `web` delegates to the
# web/ component's lifecycle script. Docker isn't reachable from
# inside the engine container, so the Metabase server is orchestrated
# on the host. (web/ is a sibling of this inner wealthdb/ dir.)
case "${1:-}" in
    build)
        shift
        # --provenance=false: buildx's default attestation would give the
        # image a fresh digest on every build even when fully cached.
        exec docker build --provenance=false -t "$IMAGE" "$REPO" "$@"
        ;;
    web)
        shift
        exec "$(cd "$REPO/.." && pwd)/web/web" "$@"
        ;;
esac

# Data root (gold DB + every silver DB) defaults to the XDG data dir
# ($XDG_DATA_HOME/wealthdb, falling back to ~/.local/share/wealthdb) but
# can live anywhere via WEALTHDB_DATA_ROOT — e.g. a shared, ACL-gated dir
# outside $HOME. It is mounted at the SAME path inside the container so
# the config's ${WEALTHDB_DATA_ROOT}/... entries resolve identically on
# both sides, and the variable is forwarded so that expansion (and the
# collectors' own wrappers) agree. The host path must be one Docker can
# see (for Colima, listed under `mounts:` in colima.yaml).
DATA_ROOT="${WEALTHDB_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/wealthdb}"

# Config file follows the XDG config dir ($XDG_CONFIG_HOME, falling back
# to ~/.config). Same-path mount + forwarded variable, like the data
# root above, so the engine's default config resolution lands on the
# mounted file on both sides.
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
CFG="$CFG_DIR/wealthdb.cfg"

mkdir -p "$CFG_DIR" "$DATA_ROOT"
[ -f "$CFG" ] || : > "$CFG"

# Allocate a TTY only when the host shell has one. The wizard
# (`wealthdb config`) requires this; the other subcommands work
# either way. Cron / piped invocations skip both flags.
TTY=""
[ -t 0 ] && [ -t 1 ] && TTY="-it"

exec docker run --rm $TTY \
    -e HOME="$HOME" \
    -e XDG_CONFIG_HOME="$CFG_DIR" \
    -e WEALTHDB_DATA_ROOT="$DATA_ROOT" \
    -u "$(id -u):$(id -g)" \
    -v "$CFG:$CFG" \
    -v "$DATA_ROOT:$DATA_ROOT" \
    "$IMAGE" \
    "$@"
