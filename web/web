#!/usr/bin/env bash
#
# web — host-side lifecycle for the optional dockerized Metabase BI
# server. Reached as `wealthdb web <subcommand>`: the wealthdb wrapper
# delegates the `web` verb here because Docker isn't reachable from
# inside the engine container, so the server is orchestrated on the
# host. See README.md / DESIGN.md.
#
# Metabase reads a read-only SNAPSHOT of the gold DB (never the live
# file), so it never contends with `wealthdb load` for the engine's
# write mutex. It is published on loopback only (127.0.0.1 + [::1]);
# reach it over an SSH port-forward + Metabase's own login.
#
# Functions are defined at top level; web_main runs only when this
# file is executed (not sourced), so test_web.sh can source it and
# unit-test the pure helpers.

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck disable=SC1091
. "$ROOT/shared/wrappers/image-tag.sh"
wealthdb_export_image_tag "$ROOT" || exit 2
WEALTHDB="${WEALTHDB_BIN:-$ROOT/wealthdb/wealthdb}"

# ---- settings ---------------------------------------------------------

# _resolve_knobs sets the operational knobs from env overrides +
# defaults. Pure (no Docker, no config round-trip); unit-tested.
_resolve_knobs() {
    IMAGE="${WEALTHDB_WEB_IMAGE:-wealthdb/metabase:$WEALTHDB_IMAGE_TAG}"
    CONTAINER="${WEALTHDB_WEB_CONTAINER:-wealthdb-metabase}"
    DATA_DIR="${WEALTHDB_WEB_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/wealthdb/web}"
    BIND="${WEALTHDB_WEB_BIND:-both}"   # both | v4 | v6
    H2_DIR="$DATA_DIR/metabase"
    SNAP="$DATA_DIR/snapshot/wealthdb.db"
    # DuckDB spill space. The driver hard-wires its temp_directory to
    # "<database_file>.tmp", which sits on the read-only snapshot mount —
    # so a writable host dir is mounted at exactly that path, letting
    # memory-capped queries spill to disk instead of dying.
    SPILL_DIR="$DATA_DIR/spill"
}

# _load_config reads the resolved `web` settings (enabled, port), the
# gold DB path, the default currency and the default reading of a
# missing cost basis from wealthdb.cfg, via the engine's `web-config`
# subcommand — the one component that parses + validates the JSON. The
# default currency stays in WEALTHDB_DEFAULT_CURRENCY and the default
# reading of a missing cost basis in WEALTHDB_MISSING_BASIS, which
# _provision passes on.
_load_config() {
    _require_docker
    local out
    if [ -n "${WEALTHDB_CONFIG:-}" ]; then
        out="$("$WEALTHDB" -c "$WEALTHDB_CONFIG" web-config)" || out=""
    else
        out="$("$WEALTHDB" web-config)" || out=""
    fi
    if [ -z "$out" ]; then
        echo "web: could not read settings via 'wealthdb web-config' (is wealthdb.cfg valid?)" >&2
        return 1
    fi
    eval "$out"
    ENABLED="${WEALTHDB_WEB_ENABLED:-0}"
    PORT="${WEALTHDB_WEB_PORT:-3000}"
    GOLD_DB="${WEALTHDB_GOLD_DB:-}"
}

_require_docker() {
    command -v docker >/dev/null 2>&1 || { echo "web: docker not found on PATH" >&2; return 1; }
}

# start and refresh time their steps and read the snapshot's mtime and
# inode through python3, and provisioning runs on it.
_require_python3() {
    command -v python3 >/dev/null 2>&1 || { echo "web: python3 not found on PATH (start and refresh need it)" >&2; return 1; }
}

# ---- pure helpers (unit-tested) ---------------------------------------

# _publish_args PORT BIND → prints `docker run` -p flags (one token
# per line) for loopback IPv4 and/or IPv6.
_publish_args() {
    local port="$1" bind="$2"
    case "$bind" in
        v4)   printf '%s\n' -p "127.0.0.1:${port}:3000" ;;
        v6)   printf '%s\n' -p "[::1]:${port}:3000" ;;
        both) printf '%s\n' -p "127.0.0.1:${port}:3000" -p "[::1]:${port}:3000" ;;
        *)    echo "web: invalid WEALTHDB_WEB_BIND '$bind' (want both|v4|v6)" >&2; return 1 ;;
    esac
}

# _docker_run_args populates the DOCKER_ARGS array from the resolved
# globals (IMAGE, CONTAINER, PORT, BIND, H2_DIR, SNAP). Pure (no exec);
# the unit test sets the globals and inspects the array.
_docker_run_args() {
    DOCKER_ARGS=(
        run -d
        --name "$CONTAINER"
        # Memory discipline. DuckDB runs in-process, so the JVM process
        # holds heap + DuckDB native memory: the container cap keeps a
        # runaway from taking the whole Docker VM to global OOM (DuckDB's
        # own memory_limit is set on the connection by provision.py), the
        # explicit -Xmx stops the heap from auto-sizing against the cap,
        # and MALLOC_ARENA_MAX curbs glibc arena hoarding under DuckDB's
        # thread pool. If the backstop ever fires anyway, restart rather
        # than staying down (metadata lives on the H2 volume).
        --memory 8g
        --restart unless-stopped
        -e JAVA_TOOL_OPTIONS=-Xmx2g
        -e MALLOC_ARENA_MAX=2
        -e MB_DB_FILE=/metabase-data/metabase.db
        -e MB_ANON_TRACKING_ENABLED=false
        # Query row limits. Metabase's defaults (10k aggregated, 2k
        # un-aggregated — and native SQL always counts as un-aggregated)
        # silently truncate the daily day × source history charts, which
        # already exceed both; the truncated series then renders as a
        # misleading partial chart with no warning. 100k gives that
        # grain decades of headroom.
        -e MB_AGGREGATED_QUERY_ROW_LIMIT=100000
        -e MB_UNAGGREGATED_QUERY_ROW_LIMIT=100000
        -v "${H2_DIR}:/metabase-data"
        -v "${SNAP}:/gold/wealthdb.db:ro"
        -v "${SPILL_DIR}:/gold/wealthdb.db.tmp"
    )
    local tok
    while IFS= read -r tok; do
        DOCKER_ARGS+=("$tok")
    done < <(_publish_args "$PORT" "$BIND")
    DOCKER_ARGS+=("$IMAGE")
}

# _snapshot SRC DST copies a DuckDB file at rest to DST atomically
# (temp + mv). Refuses if SRC has a .wal sidecar (gold mid-write / not
# checkpointed), so a torn copy is never captured. Each step checks its
# own status, so a failed copy fails even where errexit is off (_timed)
# and leaves DST and no temp file behind.
_snapshot() {
    local src="$1" dst="$2"
    if [ ! -f "$src" ]; then
        echo "web: gold DB not found at '$src' (run 'wealthdb init' / 'wealthdb load' first)" >&2
        return 1
    fi
    if [ -e "${src}.wal" ]; then
        echo "web: '$src' has a .wal sidecar — gold is mid-write or not checkpointed." >&2
        echo "     Run 'wealthdb web refresh' after 'wealthdb load' finishes (gold at rest)." >&2
        return 1
    fi
    mkdir -p "$(dirname "$dst")" || return 1
    local tmp="${dst}.tmp.$$"
    # A clone is the whole file and no bytes copied, where the file
    # system has one (APFS). Anywhere else, copy. Both keep gold's mtime,
    # so a gold write during the copy leaves gold newer than the snapshot
    # and the next refresh copies again.
    if ! cp -c "$src" "$tmp" 2>/dev/null && ! cp -p "$src" "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
}

_mtime()      { date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo unknown; }
_is_running() { [ -n "$(docker ps  -q -f "name=^${CONTAINER}\$" -f status=running 2>/dev/null)" ]; }
_exists()     { [ -n "$(docker ps -aq -f "name=^${CONTAINER}\$" 2>/dev/null)" ]; }

# ---- subcommands ------------------------------------------------------

# An image whose label matches a hash of the Dockerfile and of its base
# image is left as it is. The Dockerfile is the whole build context
# (.dockerignore), so it is the whole input; a COPY added to it must
# join the hash. An empty hash builds, with no label.
# --provenance=false: buildx's default attestation embeds build metadata,
# so the image digest would change on every build even when fully cached.
web_build() {
    local whash label=()
    whash="$(wealthdb_inputs_hash "$HERE/Dockerfile" -- "$(wealthdb_from_id "$HERE/Dockerfile")")" || whash=
    if wealthdb_build_unchanged "$IMAGE" "$whash" "$#"; then return 0; fi
    if [ -n "$whash" ]; then label=(--label "wealthdb.inputs=$whash"); fi
    exec docker build --provenance=false ${label[@]+"${label[@]}"} \
        -t "$IMAGE" "$HERE" "$@"
}

web_start() {
    _require_python3
    _load_config
    if [ "$ENABLED" != 1 ]; then
        echo "web: not enabled. Add a \"web\" block to wealthdb.cfg, e.g.:" >&2
        echo '      "web": { "enabled": true, "port": 3000 }' >&2
        return 1
    fi
    if _is_running; then
        echo "web: already running (container $CONTAINER). Use 'wealthdb web restart'." >&2
        return 1
    fi
    _exists && docker rm "$CONTAINER" >/dev/null 2>&1 || true
    mkdir -p "$H2_DIR" "$(dirname "$SNAP")" "$SPILL_DIR"
    if [ ! -f "$SNAP" ]; then
        _materialize
        echo "web: taking initial gold snapshot…" >&2
        _snapshot "$GOLD_DB" "$SNAP"
    fi

    _docker_run_args
    if ! docker "${DOCKER_ARGS[@]}" >/dev/null; then
        if [ "$BIND" = both ]; then
            echo "web: dual-stack publish failed; retrying IPv4-only (set WEALTHDB_WEB_BIND=v4 to silence)." >&2
            docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
            BIND=v4
            _docker_run_args
            docker "${DOCKER_ARGS[@]}" >/dev/null
        else
            return 1
        fi
    fi
    # The container resolved the snapshot path at this start. A later
    # refresh treats that inode as the one being served.
    _mark_snapshot_served
    _provision
    _start_banner
    # A snapshot older than the cards need leaves the server up with the
    # cards it had. Setup in the browser cannot mend that, so start says
    # what does and fails.
    if [ "$PROV_RC" = "$PROV_STALE_SNAPSHOT" ]; then
        echo "web: the gold snapshot is older than the dashboards need, so they were left as they were." >&2
        echo "     'wealthdb web refresh' re-snapshots a migrated gold." >&2
        return "$PROV_RC"
    fi
}

web_stop() {
    if _exists; then
        docker stop "$CONTAINER" >/dev/null 2>&1 || true
        docker rm   "$CONTAINER" >/dev/null 2>&1 || true
        echo "web: stopped $CONTAINER (Metabase metadata kept in $H2_DIR)"
    else
        echo "web: no container '$CONTAINER' to stop"
    fi
}

web_status() {
    _load_config
    if _is_running; then
        echo "web: running   container=$CONTAINER   port=$PORT (bind=$BIND)"
        echo "     url: http://127.0.0.1:$PORT/   (and http://[::1]:$PORT/ if IPv6 published)"
    elif _exists; then
        echo "web: stopped   (container $CONTAINER exists but is not running)"
    else
        echo "web: not running   (no container $CONTAINER)"
    fi
    if [ -f "$SNAP" ]; then
        echo "     snapshot: $SNAP  (as of $(_mtime "$SNAP"))"
    else
        echo "     snapshot: none yet — created on 'wealthdb web start' / 'refresh'"
    fi
    echo "     live gold: ${GOLD_DB:-<unset>}"
    [ "$ENABLED" = 1 ] || echo "     note: web.enabled is not set in wealthdb.cfg"
}

# _epoch is seconds since the epoch, with a fraction. macOS date has no %N.
_epoch() { python3 -c 'import time; print(f"{time.time():.3f}")'; }

# _timed LABEL CMD... runs CMD and prints its wall time on stderr.
# The command runs with set -e off so a failure still prints the
# duration. The function returns that status and leaves the caller's
# errexit as it found it, so a caller that has set -e still stops.
_timed() {
    local label="$1" start rc errexit=0
    shift
    case $- in *e*) errexit=1 ;; esac
    start="$(_epoch)"
    set +e
    "$@"
    rc=$?
    [ "$errexit" -eq 1 ] && set -e
    python3 -c 'import sys, time; print(f"web: timing: {sys.argv[1]} {time.time() - float(sys.argv[2]):.3f}s", file=sys.stderr)' \
        "$label" "$start"
    return "$rc"
}

# _stat FIELD PATH prints os.stat(PATH).FIELD (st_mtime_ns, st_ino), or
# 0 for a missing file.
_stat() {
    python3 -c 'import os, sys
p = sys.argv[2]
print(getattr(os.stat(p), sys.argv[1]) if os.path.exists(p) else 0)' "$1" "$2"
}

# _mark_snapshot_served records the snapshot inode the container just
# mounted. The snapshot keeps gold's mtime, so mtime cannot tell a file
# the container opened from one swapped in after it started.
_mark_snapshot_served() {
    _stat st_ino "$SNAP" > "${SNAP}.served"
}

_snapshot_served() {
    [ -f "$SNAP" ] && [ -f "${SNAP}.served" ] \
        && [ "$(_stat st_ino "$SNAP")" = "$(tr -d '[:space:]' < "${SNAP}.served")" ]
}

web_refresh() {
    _require_python3
    _load_config
    _timed materialize _materialize
    # Copy when the snapshot is missing or older than gold. A missing
    # gold file is stale too: the copy reports it. A running container
    # is current only when it started on this snapshot's inode, so a
    # refresh that died after the copy and before the restart still
    # restarts the next time.
    local stale=1 running=0
    if [ -f "$GOLD_DB" ] && [ -f "$SNAP" ] \
        && [ "$(_stat st_mtime_ns "$SNAP")" -ge "$(_stat st_mtime_ns "$GOLD_DB")" ]; then
        stale=0
    fi
    if _is_running; then running=1; fi
    if [ "$stale" -eq 0 ] && { [ "$running" -eq 0 ] || _snapshot_served; }; then
        echo "web: snapshot unchanged" >&2
        if [ "$running" -eq 1 ]; then
            _provision
            return "$PROV_RC"
        fi
        return 0
    fi
    if [ "$stale" -eq 1 ]; then
        echo "web: refreshing snapshot from $GOLD_DB …" >&2
        _timed snapshot _snapshot "$GOLD_DB" "$SNAP"
        echo "web: snapshot updated (as of $(_mtime "$SNAP"))"
    fi
    if [ "$running" -eq 1 ]; then
        # Recreate the container — do NOT `docker restart`. The snapshot is
        # bind-mounted as a single file (see _docker_run_args) and _snapshot
        # swaps it via atomic rename, so the new copy is a new inode. A bind
        # mount tracks the inode it resolved at container-creation time; a
        # restart preserves the old mount namespace and would keep serving the
        # stale (now-unlinked) inode. rm + run re-resolves the path to the new
        # file. Re-running start also re-provisions (idempotent), so new or
        # renamed report models show up after a refresh too.
        web_stop >/dev/null
        web_start
    fi
}

web_logs() { _require_docker; exec docker logs -f "$CONTAINER"; }

# _gen_password makes a random password meeting Metabase's complexity
# rule (>=1 lower/upper/digit/special).
_gen_password() {
    printf '%sAa1!' "$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9' | cut -c1-16)"
}

# _materialize refreshes the serving tables and the report_returns,
# report_gains, report_exposure*, report_yield_* and report_cashflow_plan
# tables in LIVE gold via the engine's hidden web-materialize subcommand,
# so the snapshot taken next carries them as fresh as the holdings. An
# engine-owned write, mutually exclusive with `wealthdb load` under the
# engine's write mutex (a concurrent load makes it fail, not wait); it
# runs BEFORE _snapshot, so a failure aborts under web_main's `set -e`
# and the previous snapshot keeps serving. The engine leaves gold
# untouched when its inputs did not change, so an unchanged gold keeps
# its mtime and the snapshot is not copied again.
_materialize() {
    echo "web: materializing serving tables, returns, gains, exposure, yield and the cash flow projection into gold …" >&2
    local rc=0
    if [ -n "${WEALTHDB_CONFIG:-}" ]; then
        "$WEALTHDB" -c "$WEALTHDB_CONFIG" web-materialize || rc=$?
    else
        "$WEALTHDB" web-materialize || rc=$?
    fi
    if [ "$rc" != 0 ]; then
        echo "web: materialization failed — gold busy (a 'wealthdb load' holds the write mutex?) or not writable." >&2
        echo "     Run 'wealthdb web refresh' once gold is idle; the previous snapshot keeps serving meanwhile." >&2
        return "$rc"
    fi
}

# provision.py's exit status for a gold snapshot older than the cards
# need (its EXIT_STALE_SNAPSHOT); any other failure exits 1.
PROV_STALE_SNAPSHOT=3

# _provision creates the admin (skipping the browser setup wizard) and
# pre-adds the gold DuckDB database via web/provision.py. Idempotent.
# Admin email/password come from env (WEALTHDB_WEB_ADMIN_EMAIL/PASSWORD,
# e.g. from ~/.secrets/wealthdb-web.env); an unset password is generated
# once and saved (chmod 600). Sets PROV_LOGIN for the start banner and
# PROV_RC to provision.py's exit status (0 when it does not run).
_provision() {
    PROV_RC=0
    if [ "${WEALTHDB_WEB_NO_PROVISION:-0}" = 1 ]; then
        echo "web: auto-provision disabled (WEALTHDB_WEB_NO_PROVISION=1)." >&2
        return 0
    fi
    local email pwfile pw pwhint
    email="${WEALTHDB_WEB_ADMIN_EMAIL:-admin@wealthdb.local}"
    pwfile="$DATA_DIR/admin-password.txt"
    if [ -n "${WEALTHDB_WEB_ADMIN_PASSWORD:-}" ]; then
        pw="$WEALTHDB_WEB_ADMIN_PASSWORD"; pwhint="from \$WEALTHDB_WEB_ADMIN_PASSWORD"
    elif [ -f "$pwfile" ]; then
        pw="$(cat "$pwfile")"; pwhint="in $pwfile"
    else
        pw="$(_gen_password)"
        (umask 077; printf '%s\n' "$pw" > "$pwfile")
        pwhint="generated, saved to $pwfile"
    fi
    echo "web: provisioning Metabase (admin + gold database + report models + dashboards)…" >&2
    # The password travels in the environment, never in argv, where any
    # process on the host could read it from `ps`.
    WEALTHDB_WEB_ADMIN_PASSWORD="$pw" python3 "$HERE/provision.py" \
         --base "http://127.0.0.1:$PORT" \
         --email "$email" --gold-path /gold/wealthdb.db --db-name gold \
         --default-currency "${WEALTHDB_DEFAULT_CURRENCY:-USD}" \
         --missing-basis "${WEALTHDB_MISSING_BASIS:-ignore}" || PROV_RC=$?
    case "$PROV_RC" in
        # The schema check follows the admin login, so the login stands.
        0|"$PROV_STALE_SNAPSHOT") PROV_LOGIN="log in as $email (password $pwhint)" ;;
        *) PROV_LOGIN="auto-provision incomplete — finish setup in the browser" ;;
    esac
}

_start_banner() {
    cat >&2 <<EOF
web: $CONTAINER is up → Metabase on http://127.0.0.1:$PORT/

  ${PROV_LOGIN:-create the admin account in the browser}

  From a laptop, tunnel the port and open it locally:
      ssh -L $PORT:127.0.0.1:$PORT <this-host>
      open http://127.0.0.1:$PORT/

  The gold DuckDB database is pre-added as a read-only snapshot, with
  report models mirroring the global / portfolios / accounts /
  positions / transactions / returns commands, plus pre-defined
  questions and the Wealth Overview / Allocation / Returns / Spending
  / Income / Cash Flow / Gains / Exposure / Yield / Data Freshness
  dashboards, most with a privacy twin that hides absolute values (all
  in the 'wealthdb (pre-defined)' collection; duplicate before
  customizing).
  Run 'wealthdb web refresh' after each 'wealthdb load' to update.
EOF
}

web_help() {
    cat <<'EOF'
wealthdb web — optional dockerized Metabase BI server (host-side)

usage:
  wealthdb web <subcommand>

subcommands:
  start      snapshot gold (if needed) and run Metabase, detached
  stop       stop + remove the container (keeps dashboards/users in H2)
  status     running state, published port, snapshot freshness
  restart    stop then start
  refresh    re-materialize the serving and report tables, copy gold to
             the read-only snapshot when gold changed, and restart
             Metabase on a new snapshot (run after 'wealthdb load')
  logs       follow the container logs
  build      build the wealthdb/metabase image
  help       this message

Metabase reads a read-only SNAPSHOT of gold (never the live file), so
it never contends with 'wealthdb load'. Published on 127.0.0.1 + [::1] only;
reach it via SSH port-forward + Metabase's own login. Enable it with a
"web" block in wealthdb.cfg:

      "web": { "enabled": true, "port": 3000 }

Auto-provision (default on): creates the admin + pre-adds the gold DB,
skipping the browser setup wizard. Credentials:
  WEALTHDB_WEB_ADMIN_EMAIL     (default admin@wealthdb.local)
  WEALTHDB_WEB_ADMIN_PASSWORD  (unset = generated + saved chmod 600)
  WEALTHDB_WEB_NO_PROVISION=1  (skip it; use the browser wizard instead)
Secrets may also live in ~/.secrets/wealthdb-web.env.

When the gold snapshot is older than the dashboards need, start, restart
and refresh leave Metabase running with the dashboards it had and exit 3.
'refresh' re-snapshots a migrated gold.

env overrides: WEALTHDB_CONFIG (non-default wealthdb.cfg path),
WEALTHDB_IMAGE_TAG (the image's tag; unset, the checkout's .image-tag,
else latest), WEALTHDB_WEB_IMAGE,
WEALTHDB_WEB_CONTAINER, WEALTHDB_WEB_DATA_DIR,
WEALTHDB_WEB_BIND (both|v4|v6), WEALTHDB_WEB_ENV_FILE (default
~/.secrets/wealthdb-web.env, read for the variables above).
EOF
}

web_main() {
    set -euo pipefail
    # Optional secrets env for admin creds etc. (repo convention:
    # secrets live in ~/.secrets, never in the config file). It is a bash
    # script: syntax-checked, then sourced with every assignment exported.
    local envf="${WEALTHDB_WEB_ENV_FILE:-$HOME/.secrets/wealthdb-web.env}"
    if [ -f "$envf" ]; then
        bash -n "$envf" || { echo "web: $envf has a syntax error" >&2; return 1; }
        set -a
        # shellcheck source=/dev/null
        . "$envf"
        set +a
    fi
    _resolve_knobs
    local cmd="${1:-help}"
    if [ "$#" -gt 0 ]; then shift; fi
    case "$cmd" in
        build)            web_build "$@" ;;
        start)            web_start ;;
        stop)             web_stop ;;
        status)           web_status ;;
        restart)          web_stop; web_start ;;
        refresh)          web_refresh ;;
        logs)             web_logs ;;
        help|-h|--help)   web_help ;;
        *) printf 'web: unknown subcommand %q\n\n' "$cmd" >&2; web_help >&2; return 2 ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    web_main "$@"
fi
