#!/usr/bin/env bash
# wealthdb-collect — collect your account data from one bank or broker
#
# usage:
#   wealthdb-collect <source> <login|download|load|prune> [flags]
#   wealthdb-collect dedup [--data-dir <root>] [--source <name>]
#   wealthdb-collect list
#
# subcommands:
#   login      sign in to the source (prompts for 2FA)
#   download   download the latest accounts + holdings
#   load       load that download into the database
#   prune      reclaim bronze disk: delete debug artefacts from complete
#              dumps + whole non-complete (crashed/dry-run) dumps. Never
#              touches a load input. Preview with --dry-run.
#   dedup      (top-level, no source) reclaim disk by sharing byte-identical
#              files across dumps — hardlink by default (portable across any
#              hard-link filesystem), --strategy clone for copy-on-write
#              reflinks where supported. Complete, quiescent dumps only;
#              transparent to load. A manual one-off sweep, never scheduled.
#              Sweeps every collector subtree under --data-dir (or one
#              --source). Preview with --dry-run.
#   list       list the sources you can collect from
#
# flags:
#   --secrets-dir <dir>   where credentials / sessions live (default ~/.secrets)
#   --data-dir <dir>      where downloaded data is written (default $XDG_DATA_HOME/wealthdb/<source>)
#   --silver-db <path>    the database file to build (default <data-dir>/<source>.db;
#                         cointracking's is <data-dir>/cointracking.duckdb).
#                         Only load reads it (plus cointracking fetch-prices),
#                         so passing it to another subcommand is an error
#                         rather than a silent no-op. ${PREFIX}_SILVER_DB is
#                         ambient config and is simply unused elsewhere.
#   --debug               (download) request bronze-resident diagnostic
#                         captures. Honoured by the browser collectors that
#                         write them (schwab-web, fidelity-web); on the others
#                         it warns that no captures are implemented yet (TODO).
#                         Off by default; prune reclaims any it writes.
#   --dry-run             (prune) print the deletion plan without removing
#                         anything; (download) walk without exporting.
#
# Flags are accepted on the subcommands they mean something on (or set the
# matching env var — see the README); a flag that does nothing on the verb
# being run is rejected rather than ignored. The exception is a flag the
# fleet forwards everywhere: --lookback is accepted by every source, and a
# source that cannot narrow its fetch warns instead of failing. Run login -> download -> load in order the first time, then
# download + load to refresh. Widen a download with --lookback (a preset:
# 1w 4w 3m 6m 1y 2y 5y all; or an ISO date; default ~90 days); reclaim disk
# afterward with prune (--dry-run first). For a source's own options, run
# `wealthdb-collect <source> --help`.
set -euo pipefail

# Find the repo this script lives in, following symlinks (macOS has no
# `readlink -f`) so `make install` can symlink it into ~/bin. Each source's
# steps live in collectors/<name>/<name>, which this dispatches to. Set
# WEALTHDB_REPO to override the auto-detected location.
_src="${BASH_SOURCE[0]}"
while [[ -h "$_src" ]]; do
    _dir="$(cd -P "$(dirname "$_src")" && pwd)"
    _src="$(readlink "$_src")"
    [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
_here="$(cd -P "$(dirname "$_src")" && pwd)"
REPO="${WEALTHDB_REPO:-$(cd "$_here/.." && pwd)}"
COLLECTORS_DIR="$REPO/collectors"

# Print the leading comment block (everything between the shebang and the
# first line of code) as the help text.
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

list_collectors() {
    local d name
    for d in "$COLLECTORS_DIR"/*/; do
        name="$(basename "$d")"
        [[ -x "$d/$name" ]] && echo "$name"
    done
}

case "${1:-}" in
    ""|-h|--help|help)
        usage
        echo
        echo "sources:"
        list_collectors | sed 's/^/  /'
        exit 0
        ;;
    list)
        list_collectors
        exit 0
        ;;
    dedup)
        # Host-side sweep over every collector subtree. collectorkit lives at
        # $REPO/shared/collectorkit; expose it on PYTHONPATH so host python3
        # finds it with no install step (mirrors the wrappers' host-side
        # prune invocation). The clone/hardlink operations act on the host
        # filesystem, so this sweep never runs in a container.
        shift
        exec env PYTHONPATH="$REPO/shared/collectorkit:${PYTHONPATH:-}" \
            python3 -m collectorkit.dedup "$@"
        ;;
esac

name="$1"; shift
wrapper="$COLLECTORS_DIR/$name/$name"
if [[ ! -x "$wrapper" ]]; then
    echo "wealthdb-collect: unknown source '$name'." >&2
    echo "Available:" >&2
    list_collectors | sed 's/^/  /' >&2
    exit 2
fi
exec "$wrapper" "$@"
